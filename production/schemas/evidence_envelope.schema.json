{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "wesnoth-starwars.production.evidence-envelope",
  "title": "Bounded production evidence identity",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id", "schema_version", "requirement_id", "requirement_revision_sha256",
    "candidate_commit", "candidate_tree", "scenario_id", "probe_id", "exercise_type",
    "difficulty", "seed", "engine_version", "engine_sha256", "dependencies",
    "artifact_path", "artifact_sha256", "exit_code", "outcome", "observations"
  ],
  "properties": {
    "schema_id": {"const": "wesnoth-starwars.production.evidence-envelope"},
    "schema_version": {"const": 1},
    "requirement_id": {"$ref": "#/$defs/identifier"},
    "requirement_revision_sha256": {"$ref": "#/$defs/sha256"},
    "candidate_commit": {"$ref": "#/$defs/gitSha"},
    "candidate_tree": {"$ref": "#/$defs/gitSha"},
    "scenario_id": {"$ref": "#/$defs/identifier"},
    "probe_id": {"$ref": "#/$defs/identifier"},
    "exercise_type": {"$ref": "#/$defs/shortText"},
    "difficulty": {"$ref": "#/$defs/shortText"},
    "seed": {"type": "string", "pattern": "^(not-applicable|[0-9a-f]{1,64})$"},
    "engine_version": {"$ref": "#/$defs/shortText"},
    "engine_sha256": {"$ref": "#/$defs/sha256"},
    "dependencies": {
      "type": "array", "minItems": 1, "maxItems": 128,
      "items": {"type": "object", "additionalProperties": false,
        "required": ["path", "sha256"],
        "properties": {"path": {"$ref": "#/$defs/path"}, "sha256": {"$ref": "#/$defs/sha256"}}}
    },
    "artifact_path": {"type": "string", "pattern": "^agent/runtime/.+"},
    "artifact_sha256": {"$ref": "#/$defs/sha256"},
    "exit_code": {"type": "integer"},
    "outcome": {"enum": ["pass", "fail", "unassessed"]},
    "observations": {"type": "array", "maxItems": 20,
      "items": {"type": "string", "minLength": 1, "maxLength": 512}}
  },
  "$defs": {
    "identifier": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{2,100}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "gitSha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "shortText": {"type": "string", "minLength": 1, "maxLength": 80},
    "path": {"type": "string", "minLength": 1, "maxLength": 512}
  }
}
