#: scenarios/heir_to_the_empire/10_thrawns_gambit.cfg:73
#: scenarios/the_last_command/10_the_last_command.cfg:56
#: scenarios/the_last_command/10_the_last_command.cfg:59
msgid "Chimaera"
msgstr ""

#. [side]: id=sw_dfr09_judicator, type=sw_unit_im_star_destroyer
#. [side]: id=sw_hte10_judicator, type=sw_unit_im_star_destroyer
#: scenarios/dark_force_rising/09_battle_for_the_fleet.cfg:78
#: scenarios/dark_force_rising/09_battle_for_the_fleet.cfg:81
#: scenarios/heir_to_the_empire/10_thrawns_gambit.cfg:95
#: scenarios/heir_to_the_empire/10_thrawns_gambit.cfg:98
msgid "Judicator"
msgstr ""

#. [event]
#: scenarios/dark_force_rising/09_battle_for_the_fleet.cfg:137
msgid "Katana"
msgstr ""

#. [event]
#: scenarios/dark_force_rising/09_battle_for_the_fleet.cfg:138
msgid "Valorous"
msgstr ""

#. [event]
#: scenarios/dark_force_rising/09_battle_for_the_fleet.cfg:139
msgid "Steadfast"
msgstr ""

#. [label]
#: scenarios/dark_force_rising/09_battle_for_the_fleet.cfg:151
msgid "Jump Point"
msgstr ""

#. [objective]: condition=win
#: scenarios/dark_force_rising/09_battle_for_the_fleet.cfg:156
msgid "Two Dreadnaughts reach the eastern edge and jump to safety"
msgstr ""

#. [objective]: condition=lose
#: scenarios/dark_force_rising/09_battle_for_the_fleet.cfg:160
msgid "Two Dreadnaughts destroyed"
msgstr ""

#. [event]
#: scenarios/dark_force_rising/09_battle_for_the_fleet.cfg:174
msgid "Commendable speed. But slaved ships are only as clever as the one ship that guides them. Target the Katana first, Captain."
msgstr ""

#. [message]: speaker=sw_hero_wedge
#: scenarios/dark_force_rising/09_battle_for_the_fleet.cfg:177
msgid "Every fighter on the Dreadnaughts. Bombers will go for the Katana. Don't let them through."
msgstr ""

#. [floating_text]
#: scenarios/dark_force_rising/09_battle_for_the_fleet.cfg:200
msgid "Jumped to lightspeed"
msgstr ""

#. [message]: speaker=sw_hero_wedge
#: scenarios/dark_force_rising/09_battle_for_the_fleet.cfg:234
msgid "We can't save enough of them. All fighters, break off!"
msgstr ""

#. [message]: speaker=sw_hero_luke
#: scenarios/dark_force_rising/09_battle_for_the_fleet.cfg:247
msgid "Two of them made the jump. It's not two hundred, Wedge, but he doesn't have them all."
msgstr ""

#. [event]
#: scenarios/dark_force_rising/09_battle_for_the_fleet.cfg:249
msgid "A small loss, Captain Pellaeon. We hold the rest of the fleet, and crews for every hull are already growing. Withdraw."
msgstr ""

#. [scenario]: id=sw_dfr_10_honoghrs_choice
#: scenarios/dark_force_rising/10_honoghrs_choice.cfg:11
msgid "Honoghr's Choice"
msgstr ""

#. [part]
#: scenarios/dark_force_rising/10_honoghrs_choice.cfg:24
msgid "Leia returned to Honoghr with a sample of the soil and a droid's maintenance records. The decontamination droids had never been cleaning the land. They had been keeping it poisoned, so that the Noghri would need the Empire forever."
msgstr ""

#. [part]
#: scenarios/dark_force_rising/10_honoghrs_choice.cfg:27
msgid "She stood in the clan house at Nystao and told them. Before the clans could answer, an Imperial shuttle landed to take her away."
msgstr ""

#. [side]: id=sw_hero_leia, type=sw_hero_leia
#: scenarios/dark_force_rising/10_honoghrs_choice.cfg:38
msgid "Leia and the Noghri"
msgstr ""

#. [side]: id=sw_dfr10_commander, type=sw_unit_im_officer
#: scenarios/dark_force_rising/10_honoghrs_choice.cfg:53
msgid "Imperial Detachment"
msgstr ""

#. [side]: id=sw_dfr10_commander, type=sw_unit_im_officer
#: scenarios/dark_force_rising/10_honoghrs_choice.cfg:56
msgid "Commander Sorrell"
msgstr ""

#. [side]
#: scenarios/dark_force_rising/10_honoghrs_choice.cfg:86
msgid "Noghri Clans"
msgstr ""

#. [objective]: condition=win
#: scenarios/dark_force_rising/10_honoghrs_choice.cfg:113
msgid "Hold out until the clans decide (end of the last turn)"
msgstr ""

#. [objective]: condition=win
#: scenarios/dark_force_rising/10_honoghrs_choice.cfg:117
msgid "Defeat Commander Sorrell"
msgstr ""

#. [note]
#: scenarios/dark_force_rising/10_honoghrs_choice.cfg:126
msgid "A second Imperial shuttle lands east of the village on turn 4. On turn 6 the Noghri clans give their answer and join your side."
msgstr ""

#. [message]: speaker=sw_hero_khabarakh
#: scenarios/dark_force_rising/10_honoghrs_choice.cfg:135
msgid "The clans are still debating, my lady. They will not move until they have decided. We must hold the dukha until then."
msgstr ""

#. [message]: speaker=sw_hero_leia
#: scenarios/dark_force_rising/10_honoghrs_choice.cfg:139
msgid "Then we hold it. Chewie, the west door."
msgstr ""

#. [message]: speaker=sw_hero_khabarakh
#: scenarios/dark_force_rising/10_honoghrs_choice.cfg:164
msgid "A second shuttle, east of the village!"
msgstr ""

#. [message]: speaker=narrator
#: scenarios/dark_force_rising/10_honoghrs_choice.cfg:194
msgid "The clans have spoken. We served the Empire for a generation because it told us we owed it our lives. It lied. The Lady Vader is under our protection."
msgstr ""

#. [message]: speaker=sw_hero_leia
#: scenarios/dark_force_rising/10_honoghrs_choice.cfg:198
msgid "Thank you. You don't owe me anything. But I'll be glad of the help."
msgstr ""

#. [message]: speaker=sw_hero_khabarakh
#: scenarios/dark_force_rising/10_honoghrs_choice.cfg:223
msgid "The Empire will learn of this. And every Noghri who guards the Grand Admiral will learn of it too."
msgstr ""

#. [message]: speaker=sw_hero_leia
#: scenarios/dark_force_rising/10_honoghrs_choice.cfg:227
msgid "Then he's about to discover what it's like to be watched by his own bodyguards."
msgstr ""

#. [event]
#: scenarios/dark_force_rising/10_honoghrs_choice.cfg:229
msgid "The Noghri have broken with us? ... Interesting. Then it is time to finish this war quickly, before they learn how much they know."
msgstr ""

#. [scenario]: id=sw_hte_01_ysalamiri_harvest
#: scenarios/heir_to_the_empire/01_ysalamiri_harvest.cfg:16
msgid "The Grand Admiral's Harvest"
msgstr ""

#. [part]
#: scenarios/heir_to_the_empire/01_ysalamiri_harvest.cfg:29
msgid "Five years after the Battle of Endor, the Empire is a shadow of itself. Its remaining fleets hold a quarter of the galaxy, and the New Republic expects them to collapse."
msgstr ""

#. [part]
#: scenarios/heir_to_the_empire/01_ysalamiri_harvest.cfg:32
msgid "But a Grand Admiral has returned from the Unknown Regions. He has studied the Rebellion's leaders the way he studies art, and he has begun to prepare."
msgstr ""

#. [part]
#: scenarios/heir_to_the_empire/01_ysalamiri_harvest.cfg:35
msgid "His first step leads to Myrkr, a forest world avoided by the Jedi of old and favored by smugglers. Something in its trees blinds the Force."
msgstr ""

#. [side]: id=sw_hero_pellaeon, type=sw_hero_pellaeon
#: scenarios/heir_to_the_empire/01_ysalamiri_harvest.cfg:53
msgid "Imperial Landing Party"
msgstr ""

#. [side]: id=sw_hero_pellaeon, type=sw_hero_pellaeon
#: scenarios/heir_to_the_empire/01_ysalamiri_harvest.cfg:56
msgid "Gilad Pellaeon"
msgstr ""

#. [side]
#: scenarios/heir_to_the_empire/01_ysalamiri_harvest.cfg:71
msgid "Vornskr Packs"
msgstr ""

#. [side]
#: scenarios/heir_to_the_empire/01_ysalamiri_harvest.cfg:86
msgid "Karrde's Smugglers"
msgstr ""

#. [unit]: id=sw_hte01_aves, type=sw_unit_sm_veteran
#: scenarios/heir_to_the_empire/01_ysalamiri_harvest.cfg:92
msgid "Aves"
msgstr ""

#. [label]
#: scenarios/heir_to_the_empire/01_ysalamiri_harvest.cfg:195
msgid "Ysalamiri"
msgstr ""

#. [label]
#: scenarios/heir_to_the_empire/01_ysalamiri_harvest.cfg:202
msgid "Lambda Shuttle"
msgstr ""

#. [label]
#: scenarios/heir_to_the_empire/01_ysalamiri_harvest.cfg:206
msgid "Smugglers' Camp"
msgstr ""

#. [objective]: condition=win
#: scenarios/heir_to_the_empire/01_ysalamiri_harvest.cfg:212
msgid "Harvest the four marked ysalamiri and bring each nutrient frame back to the shuttle (its landing pad or the landing apron around it)"
msgstr ""

#. [objective]: condition=lose
#: scenarios/heir_to_the_empire/01_ysalamiri_harvest.cfg:216
msgid "Death of Captain Pellaeon"
msgstr ""

#. [note]
#: scenarios/heir_to_the_empire/01_ysalamiri_harvest.cfg:221
msgid "Move a unit onto a marked tree to take its ysalamiri. A unit can carry only one frame. If the carrier falls, the frame returns to its tree."
msgstr ""

#. [note]
#: scenarios/heir_to_the_empire/01_ysalamiri_harvest.cfg:224
msgid "Karrde's smugglers are allowing the harvest. Leave them alone."
msgstr ""

#. [event]
#: scenarios/heir_to_the_empire/01_ysalamiri_harvest.cfg:231
msgid "Captain, the creatures we need cling to the high branches. Four nutrient frames should be enough to start."
msgstr ""

#. [message]: speaker=sw_hero_pellaeon
#: scenarios/heir_to_the_empire/01_ysalamiri_harvest.cfg:234
msgid "Four lizards on four sticks, Admiral. I hope you will tell me what they are for."
msgstr ""

#. [event]
#: scenarios/heir_to_the_empire/01_ysalamiri_harvest.cfg:236
msgid "Each one pushes back the Force around itself, like a bubble in water. A Jedi standing inside one is an ordinary man. Mind the vornskrs; they hunt anything that touches the Force, and they are not particular about the rest."
msgstr ""

#. [message]: speaker=sw_hte01_aves
#: scenarios/heir_to_the_empire/01_ysalamiri_harvest.cfg:239
msgid "Karrde says take what you came for and go. Our people stay out of your way, and you stay out of ours."
msgstr ""

#. [message]: speaker=sw_hero_pellaeon
#: scenarios/heir_to_the_empire/01_ysalamiri_harvest.cfg:243
msgid "Understood. Squads, form up. Keep your eyes on the trees."
msgstr ""

#. [dummy]: id=sw_ability_ysalamiri
#: scenarios/heir_to_the_empire/01_ysalamiri_harvest.cfg:318
msgid "ysalamiri frame"
msgstr ""

#. [dummy]: id=sw_ability_ysalamiri
#: scenarios/heir_to_the_empire/01_ysalamiri_harvest.cfg:319
msgid "Carries a ysalamiri in its nutrient frame. The creature pushes the Force away from every hex within one of its bearer."
msgstr ""

#. [floating_text]
#: scenarios/heir_to_the_empire/01_ysalamiri_harvest.cfg:332
msgid "Frame secured"
msgstr ""

#. [floating_text]
#: scenarios/heir_to_the_empire/01_ysalamiri_harvest.cfg:381
msgid "Frame delivered"
msgstr ""

#. [message]: speaker=sw_hero_pellaeon
#: scenarios/heir_to_the_empire/01_ysalamiri_harvest.cfg:419
msgid "We lost a frame! The creature will have gone back to its branch. Send another squad."
msgstr ""

#. [message]: speaker=second_unit
#: scenarios/heir_to_the_empire/01_ysalamiri_harvest.cfg:452
msgid "Movement in the brush! Vornskrs!"
msgstr ""

#. [message]: speaker=sw_hero_pellaeon
#: scenarios/heir_to_the_empire/01_ysalamiri_harvest.cfg:460
msgid "All four frames are aboard, Admiral."
msgstr ""

#. [event]
#: scenarios/heir_to_the_empire/01_ysalamiri_harvest.cfg:462
msgid "Well done, Captain. Now we need a Jedi to test them on, and Intelligence tells me where one will be. Return to the Chimaera."
msgstr ""

#. [scenario]: id=sw_hte_02_ambush_at_bpfassh
#: scenarios/heir_to_the_empire/02_ambush_at_bpfassh.cfg:12
msgid "Ambush at Bpfassh"
msgstr ""

#. [part]
#: scenarios/heir_to_the_empire/02_ambush_at_bpfassh.cfg:25
msgid "On Coruscant, the New Republic's leaders argue over trade quotas and old grievances. Leia Organa Solo, pregnant with twins, has come to Bpfassh to steady a nervous system government."
msgstr ""

#. [part]
#: scenarios/heir_to_the_empire/02_ambush_at_bpfassh.cfg:28
msgid "Han Solo and Chewbacca came with her. They did not expect the Empire to come too."
msgstr ""

#. [side]: id=sw_hte02_raid_commander, type=sw_unit_im_officer
#. [side]: id=sw_hte08_harbid, type=sw_unit_im_officer
#: scenarios/heir_to_the_empire/02_ambush_at_bpfassh.cfg:60
#: scenarios/heir_to_the_empire/08_nomad_city.cfg:67
msgid "Imperial Raiders"
msgstr ""

#. [side]: id=sw_hte02_raid_commander, type=sw_unit_im_officer
#: scenarios/heir_to_the_empire/02_ambush_at_bpfassh.cfg:63
msgid "Major Brendt"
msgstr ""

#. [side]
#: scenarios/heir_to_the_empire/02_ambush_at_bpfassh.cfg:104
msgid "Bpfassh Militia"
msgstr ""

#. [unit]: id=sw_hte02_militia_captain, type=sw_unit_nr_trooper
#: scenarios/heir_to_the_empire/02_ambush_at_bpfassh.cfg:110
msgid "Captain Tarvan"
msgstr ""

#. [label]
#: scenarios/heir_to_the_empire/02_ambush_at_bpfassh.cfg:158
msgid "Assembly Plaza"
msgstr ""

#. [objective]: condition=win
#: scenarios/heir_to_the_empire/02_ambush_at_bpfassh.cfg:163
msgid "Leia reaches the Millennium Falcon"
msgstr ""

#. [objective]: condition=lose
#: scenarios/heir_to_the_empire/02_ambush_at_bpfassh.cfg:167
msgid "Death of Leia, Han, or Chewbacca"
msgstr ""

#. [note]
#: scenarios/heir_to_the_empire/02_ambush_at_bpfassh.cfg:174
msgid "Noghri commandos are invisible in the parks and at night until you move next to them."
msgstr ""

#. [message]: speaker=sw_hte02_militia_captain
#: scenarios/heir_to_the_empire/02_ambush_at_bpfassh.cfg:185
msgid "Your Highness, Imperial landing craft in the north district! It's a raid. They're hitting the warehouses and pulling out."
msgstr ""

#. [message]: speaker=sw_hero_han
#: scenarios/heir_to_the_empire/02_ambush_at_bpfassh.cfg:189
msgid "A raid this far inside our territory? I don't like it. Leia, we're going to the Falcon. Now."
msgstr ""

#. [message]: speaker=sw_hero_leia
#: scenarios/heir_to_the_empire/02_ambush_at_bpfassh.cfg:193
msgid "Not without making sure these people can hold. Captain, keep the plaza. We'll go through the east district."
msgstr ""

#. [message]: speaker=sw_hero_chewbacca
#: scenarios/heir_to_the_empire/02_ambush_at_bpfassh.cfg:197
msgid "<i>(Chewbacca growls and checks his bowcaster.)</i>"
msgstr ""

#. [message]: speaker=sw_hero_han
#: scenarios/heir_to_the_empire/02_ambush_at_bpfassh.cfg:209
msgid "Those aren't stormtroopers. Gray skin, no armor, no sound. Leia, stay behind Chewie!"
msgstr ""

#. [message]: speaker=sw_hero_leia
#: scenarios/heir_to_the_empire/02_ambush_at_bpfassh.cfg:213
msgid "They're not shooting to kill, Han. They want me alive."
msgstr ""

#. [message]: speaker=sw_hte02_militia_captain
#: scenarios/heir_to_the_empire/02_ambush_at_bpfassh.cfg:222
msgid "TIE fighters, coming in low over the plaza! Take cover!"
msgstr ""

#. [message]: speaker=sw_hte02_militia_captain
#: scenarios/heir_to_the_empire/02_ambush_at_bpfassh.cfg:263
msgid "More of our people are coming in from the south. We'll hold them, Your Highness!"
msgstr ""

#. [message]: speaker=sw_hero_han
#: scenarios/heir_to_the_empire/02_ambush_at_bpfassh.cfg:275
msgid "Chewie, get the engines warm! Everybody aboard!"
msgstr ""

#. [message]: speaker=sw_hero_leia
#: scenarios/heir_to_the_empire/02_ambush_at_bpfassh.cfg:279
msgid "Han, those commandos were after me, not the warehouses. Someone knew exactly where I would be."
msgstr ""

#. [message]: speaker=sw_hero_han
#: scenarios/heir_to_the_empire/02_ambush_at_bpfassh.cfg:283
msgid "Then we stop being where people expect. And we tell Luke. Wherever he's got to."
msgstr ""

#. [scenario]: id=sw_hte_03_adrift
#: scenarios/heir_to_the_empire/03_adrift.cfg:17
msgid "Adrift"
msgstr ""

#. [part]
#: scenarios/heir_to_the_empire/03_adrift.cfg:31
msgid "Far from Bpfassh, Luke Skywalker flies alone toward a meeting he was told the New Republic had arranged."
msgstr ""

#. [part]
#: scenarios/heir_to_the_empire/03_adrift.cfg:34
msgid "The message was false. A gravity-well trap pulls his X-wing out of hyperspace beside a drifting asteroid cluster, and a patrol of TIE fighters is already waiting."
msgstr ""

#. [side]
#: scenarios/heir_to_the_empire/03_adrift.cfg:68
msgid "Imperial Patrol"
msgstr ""

#. [regenerate]: id=sw_ability_astromech_repairs
#: scenarios/heir_to_the_empire/03_adrift.cfg:118
msgid "astromech repairs"
msgstr ""

#. [regenerate]: id=sw_ability_astromech_repairs
#: scenarios/heir_to_the_empire/03_adrift.cfg:119
msgid "Luke's astromech droid repairs 6 HP of damage at the start of each turn."
msgstr ""

#. [objective]: condition=win
#: scenarios/heir_to_the_empire/03_adrift.cfg:144
msgid "Survive until the end of the last turn"
msgstr ""

#. [objective]: condition=win
#: scenarios/heir_to_the_empire/03_adrift.cfg:148
msgid "Destroy every TIE fighter in the patrol"
msgstr ""

#. [note]
#: scenarios/heir_to_the_empire/03_adrift.cfg:162
msgid "Asteroid fields give your X-wing cover (60% defense) but cost 2 movement."
msgstr ""

#. [note]
#: scenarios/heir_to_the_empire/03_adrift.cfg:165
msgid "Destroying the whole patrol earns a bonus: the Wild Karrde's crew will be more impressed."
msgstr ""

#. [message]: speaker=sw_hero_luke
#: scenarios/heir_to_the_empire/03_adrift.cfg:198
msgid "More of them. They knew I was coming. Somebody set this up."
msgstr ""

#. [message]: speaker=sw_hero_luke
#: scenarios/heir_to_the_empire/03_adrift.cfg:223
msgid "Hyperdrive's out, and the motivator is smoking. Easy. Let's see what they've got."
msgstr ""

#. [message]: speaker=narrator
#: scenarios/heir_to_the_empire/03_adrift.cfg:227
msgid "Astromech"
msgstr ""

#. [message]: speaker=narrator
#: scenarios/heir_to_the_empire/03_adrift.cfg:228
msgid "<i>(Luke's astromech whistles a long, unhappy string of notes.)</i>"
msgstr ""

#. [message]: speaker=sw_hero_luke
#: scenarios/heir_to_the_empire/03_adrift.cfg:232
msgid "I know. Use the rocks for cover and keep the shields patched. Somebody will have heard the distress call."
msgstr ""

#. [message]: speaker=sw_hero_luke
#: scenarios/heir_to_the_empire/03_adrift.cfg:262
msgid "That's the last of them. Now I just have to wait."
msgstr ""

#. [message]: speaker=narrator
#: scenarios/heir_to_the_empire/03_adrift.cfg:283
#: scenarios/heir_to_the_empire/03_adrift.cfg:293
msgid "Wild Karrde"
msgstr ""

#. [message]: speaker=narrator
#: scenarios/heir_to_the_empire/03_adrift.cfg:284
msgid "Unidentified X-wing, this is the freighter Wild Karrde. Your drive signature is a mess and your friends are leaving. Stand by for tractor beam."
msgstr ""

#. [message]: speaker=sw_hero_luke
#: scenarios/heir_to_the_empire/03_adrift.cfg:288
msgid "Wild Karrde, I appreciate the help. Who am I talking to?"
msgstr ""

#. [message]: speaker=narrator
#: scenarios/heir_to_the_empire/03_adrift.cfg:294
msgid "Someone who's going to have a lot of questions for you, Skywalker. Power down your weapons."
msgstr ""

#. [scenario]: id=sw_hte_04_shadows_of_kashyyyk
#: scenarios/heir_to_the_empire/04_shadows_of_kashyyyk.cfg:15
msgid "Shadows of Kashyyyk"
msgstr ""

#. [part]
#: scenarios/heir_to_the_empire/04_shadows_of_kashyyyk.cfg:42
msgid "Han sent Leia and Chewbacca to the one place he trusted to hide her: Kashyyyk, where an entire world owes Chewbacca's friends a debt."
msgstr ""

#. [part]
#: scenarios/heir_to_the_empire/04_shadows_of_kashyyyk.cfg:45
msgid "High in the branches of the wroshyr trees, the Wookiees gave them shelter. The Noghri followed anyway."
msgstr ""

#. [side]
#: scenarios/heir_to_the_empire/04_shadows_of_kashyyyk.cfg:78
msgid "Noghri Commandos"
msgstr ""

#. [side]
#: scenarios/heir_to_the_empire/04_shadows_of_kashyyyk.cfg:99
msgid "Wookiees of Rwookrrorro"
msgstr ""

#. [unit]: id=sw_hte04_ralrra, type=sw_unit_wk_lookout
#: scenarios/heir_to_the_empire/04_shadows_of_kashyyyk.cfg:105
msgid "Ralrra"
msgstr ""

#. [objective]: condition=win
#: scenarios/heir_to_the_empire/04_shadows_of_kashyyyk.cfg:150
msgid "Survive until dawn"
msgstr ""

#. [objective]: condition=win
#: scenarios/heir_to_the_empire/04_shadows_of_kashyyyk.cfg:154
msgid "Defeat every Noghri commando"
msgstr ""

#. [note]
#: scenarios/heir_to_the_empire/04_shadows_of_kashyyyk.cfg:163
msgid "Noghri are invisible in forest and at night. A Wookiee Lookout reveals every Noghri within two hexes."
msgstr ""

#. [message]: speaker=sw_hte04_ralrra
#: scenarios/heir_to_the_empire/04_shadows_of_kashyyyk.cfg:172
msgid "<i>(Ralrra speaks in the Wookiee tongue; Chewbacca translates in growls and gestures.)</i> The trees are quiet tonight. Too quiet. My lookouts will watch the branches."
msgstr ""

#. [message]: speaker=sw_hero_leia
#: scenarios/heir_to_the_empire/04_shadows_of_kashyyyk.cfg:176
msgid "Thank you, Ralrra. If they come, they'll come for me. Keep your people back from the edges."
msgstr ""

#. [message]: speaker=sw_hero_chewbacca
#: scenarios/heir_to_the_empire/04_shadows_of_kashyyyk.cfg:180
msgid "<i>(Chewbacca rumbles a refusal and plants himself beside her.)</i>"
msgstr ""

#. [message]: speaker=sw_hte04_ralrra
#: scenarios/heir_to_the_empire/04_shadows_of_kashyyyk.cfg:218
msgid "More of them in the lower branches. They move like smoke."
msgstr ""

#. [message]: speaker=sw_hero_leia
#: scenarios/heir_to_the_empire/04_shadows_of_kashyyyk.cfg:242
msgid "There, in the branches. The same gray commandos from Bpfassh."
msgstr ""

#. [message]: speaker=sw_hero_leia
#: scenarios/heir_to_the_empire/04_shadows_of_kashyyyk.cfg:284
msgid "They're withdrawing. One of them looked at me before it went, almost as if it recognized me. I don't understand them."
msgstr ""

#. [message]: speaker=sw_hte04_ralrra
#: scenarios/heir_to_the_empire/04_shadows_of_kashyyyk.cfg:288
msgid "Whatever they are, they will not find you so easily in our trees again."
msgstr ""

#. [scenario]: id=sw_hte_05_prisoner_of_myrkr
#: scenarios/heir_to_the_empire/05_prisoner_of_myrkr.cfg:16
msgid "Prisoner of Myrkr"
msgstr ""

#. [part]
#: scenarios/heir_to_the_empire/05_prisoner_of_myrkr.cfg:29
msgid "The Wild Karrde brought Luke to Myrkr. Talon Karrde was polite, curious, and unwilling to let him go: the Empire is offering a great deal of money for a Jedi."
msgstr ""

#. [part]
#: scenarios/heir_to_the_empire/05_prisoner_of_myrkr.cfg:32
msgid "Inside the compound, among the ysalamiri, Luke cannot feel the Force at all. He will have to escape the way anyone else would."
msgstr ""

#. [side]
#: scenarios/heir_to_the_empire/05_prisoner_of_myrkr.cfg:67
msgid "Karrde's Guards"
msgstr ""

#. [unit]: id=sw_hte05_drang, type=sw_unit_wl_vornskr
#: scenarios/heir_to_the_empire/05_prisoner_of_myrkr.cfg:90
msgid "Drang"
msgstr ""

#. [effect]: type=impact
#. [attack]: type=impact
#: scenarios/heir_to_the_empire/05_prisoner_of_myrkr.cfg:131
#: units/dfr_units.cfg:385
#: units/hte_heroes.cfg:411
#: units/hte_heroes.cfg:550
#: units/hte_heroes.cfg:826
#: units/hte_heroes.cfg:1114
#: units/hte_heroes.cfg:1421
#: units/hte_heroes.cfg:1560
#: units/hte_imperial.cfg:452
#: units/hte_new_republic.cfg:450
#: units/hte_new_republic.cfg:700
msgid "fists"
msgstr ""

#. [label]
#: scenarios/heir_to_the_empire/05_prisoner_of_myrkr.cfg:146
msgid "Karrde's Office"
msgstr ""

#. [label]
#: scenarios/heir_to_the_empire/05_prisoner_of_myrkr.cfg:154
msgid "Vehicle Shed"
msgstr ""

#. [objective]: condition=win
#: scenarios/heir_to_the_empire/05_prisoner_of_myrkr.cfg:159
msgid "Recover your lightsaber from Karrde's office"
msgstr ""

#. [objective]: condition=win
#: scenarios/heir_to_the_empire/05_prisoner_of_myrkr.cfg:171
msgid "Reach the vehicle shed with your lightsaber"
msgstr ""

#. [note]
#: scenarios/heir_to_the_empire/05_prisoner_of_myrkr.cfg:180
msgid "The whole compound is inside a ysalamiri bubble: Luke's Force abilities and deflection do not work."
msgstr ""

#. [note]
#: scenarios/heir_to_the_empire/05_prisoner_of_myrkr.cfg:183
msgid "Guards stay at their posts until something comes within reach."
msgstr ""

#. [message]: speaker=sw_hero_luke
#: scenarios/heir_to_the_empire/05_prisoner_of_myrkr.cfg:192
msgid "Nothing. It's like going deaf. Karrde's lizards are everywhere in this place."
msgstr ""

#. [message]: speaker=sw_hero_luke
#: scenarios/heir_to_the_empire/05_prisoner_of_myrkr.cfg:196
msgid "All right. One guard at the door. My lightsaber will be in Karrde's office. I'm not leaving without it."
msgstr ""

#. [effect]: type=fire
#. [attack]: type=fire
#: scenarios/heir_to_the_empire/05_prisoner_of_myrkr.cfg:220
#: units/hte_heroes.cfg:977
msgid "hold-out blaster"
msgstr ""

#. [message]: speaker=sw_hero_luke
#: scenarios/heir_to_the_empire/05_prisoner_of_myrkr.cfg:230
msgid "Somebody's spare hold-out blaster. Careless of them."
msgstr ""

#. [message]: speaker=sw_hero_luke
#: scenarios/heir_to_the_empire/05_prisoner_of_myrkr.cfg:255
msgid "There you are."
msgstr ""

#. [message]: speaker=sw_hte05_mara
#: scenarios/heir_to_the_empire/05_prisoner_of_myrkr.cfg:286
msgid "Skywalker's loose! He's in the main house. Nobody shoots him except me."
msgstr ""

#. [message]: speaker=sw_hero_luke
#: scenarios/heir_to_the_empire/05_prisoner_of_myrkr.cfg:290
msgid "She means that. Time to find a vehicle."
msgstr ""

#. [message]: speaker=sw_hero_luke
#: scenarios/heir_to_the_empire/05_prisoner_of_myrkr.cfg:311
msgid "A skiff. Fueled, too. Let's see how far it gets me."
msgstr ""

#. [message]: speaker=narrator
#: scenarios/heir_to_the_empire/05_prisoner_of_myrkr.cfg:317
msgid "Not far, Skywalker. I'm right behind you."
msgstr ""

#. [message]: speaker=sw_hero_luke
#: scenarios/heir_to_the_empire/05_prisoner_of_myrkr.cfg:328
msgid "Not without my lightsaber."
msgstr ""

#. [scenario]: id=sw_hte_06_raid_on_karrdes_base
#: scenarios/heir_to_the_empire/06_raid_on_karrdes_base.cfg:20
msgid "Raid on Karrde's Base"
msgstr ""

#. [part]
#: scenarios/heir_to_the_empire/06_raid_on_karrdes_base.cfg:33
msgid "Han Solo and Lando Calrissian came to Myrkr following a rumor: Talon Karrde knew where Luke Skywalker was."
msgstr ""

#. [part]
#: scenarios/heir_to_the_empire/06_raid_on_karrdes_base.cfg:36
msgid "Karrde received them warmly and told them nothing. That night Luke escaped, and by morning an Imperial assault force was landing outside the walls, looking for him."
msgstr ""

#. [side]: id=sw_hero_han, type=sw_hero_han
#: scenarios/heir_to_the_empire/06_raid_on_karrdes_base.cfg:53
msgid "New Republic and Karrde's People"
msgstr ""

#. [side]: id=sw_hte06_vosk, type=sw_unit_im_officer
#: scenarios/heir_to_the_empire/06_raid_on_karrdes_base.cfg:68
msgid "Imperial Assault Force"
msgstr ""

#. [side]: id=sw_hte06_vosk, type=sw_unit_im_officer
#: scenarios/heir_to_the_empire/06_raid_on_karrdes_base.cfg:71
msgid "Captain Vosk"
msgstr ""

#. [event]
#. [side]: id=sw_hero_karrde, type=sw_hero_karrde
#: scenarios/heir_to_the_empire/06_raid_on_karrdes_base.cfg:115
#: scenarios/the_last_command/02_the_smugglers_council.cfg:40
msgid "Talon Karrde"
msgstr ""

#. [label]
#: scenarios/heir_to_the_empire/06_raid_on_karrdes_base.cfg:153
msgid "Transport"
msgstr ""

#. [objective]: condition=win
#: scenarios/heir_to_the_empire/06_raid_on_karrdes_base.cfg:161
msgid "Get Karrde's people to the transports on the landing field"
msgstr ""

#. [objective]: condition=win
#: scenarios/heir_to_the_empire/06_raid_on_karrdes_base.cfg:165
msgid "Then bring Han and Lando to the transports"
msgstr ""

#. [objective]: condition=lose
#: scenarios/heir_to_the_empire/06_raid_on_karrdes_base.cfg:169
msgid "Death of Han, Lando, or Karrde"
msgstr ""

#. [note]
#: scenarios/heir_to_the_empire/06_raid_on_karrdes_base.cfg:176
msgid "Karrde and his smugglers leave the battle when they reach a transport. Karrde counts as an evacuee."
msgstr ""

#. [message]: speaker=sw_hero_karrde
#: scenarios/heir_to_the_empire/06_raid_on_karrdes_base.cfg:188
msgid "An Imperial assault force, at my front gate. Someone has been very indiscreet about my guest."
msgstr ""

#. [message]: speaker=sw_hero_han
#: scenarios/heir_to_the_empire/06_raid_on_karrdes_base.cfg:192
msgid "Guest? You had Luke here?"
msgstr ""

#. [message]: speaker=sw_hero_karrde
#: scenarios/heir_to_the_empire/06_raid_on_karrdes_base.cfg:196
msgid "Had, Captain Solo. He left last night, with my second-in-command close behind him. We can argue about it later. My people need to reach the transports."
msgstr ""

#. [message]: speaker=sw_hero_lando
#: scenarios/heir_to_the_empire/06_raid_on_karrdes_base.cfg:200
msgid "Then let's give them a reason to keep their heads down. Han, you take the house; I'll take the yard."
msgstr ""

#. [floating_text]
#: scenarios/heir_to_the_empire/06_raid_on_karrdes_base.cfg:221
msgid "Evacuated"
msgstr ""

#. [message]: speaker=sw_hero_han
#: scenarios/heir_to_the_empire/06_raid_on_karrdes_base.cfg:236
msgid "That's enough of them aboard. Lando, time to go!"
msgstr ""

#. [message]: speaker=sw_hero_lando
#: scenarios/heir_to_the_empire/06_raid_on_karrdes_base.cfg:282
msgid "Karrde says the Imperials have speeder bikes out in the forest. They're still hunting Luke."
msgstr ""

#. [message]: speaker=sw_hero_han
#: scenarios/heir_to_the_empire/06_raid_on_karrdes_base.cfg:286
msgid "Then Luke's alive and they haven't caught him. That's the best news I've had all week. Punch it."
msgstr ""

#. [scenario]: id=sw_hte_07_the_forest_crossing
#: scenarios/heir_to_the_empire/07_the_forest_crossing.cfg:16
msgid "The Forest Crossing"
msgstr ""

#. [part]
#: scenarios/heir_to_the_empire/07_the_forest_crossing.cfg:29
msgid "Luke's stolen skiff made it a few kilometers before Mara Jade's shots brought it down. Her own craft followed it into the trees."
msgstr ""

#. [part]
#: scenarios/heir_to_the_empire/07_the_forest_crossing.cfg:32
msgid "Now the two of them are alone in the Myrkr forest with Imperial speeder bikes overhead. Hyllyard City is days away on foot. Mara has made it clear she would rather kill Luke than help him, but neither of them will get there alone."
msgstr ""

#. [side]: id=sw_hero_luke, type=sw_hero_luke
#: scenarios/heir_to_the_empire/07_the_forest_crossing.cfg:49
#: scenarios/the_last_command/04_landfall_on_wayland.cfg:41
#: scenarios/the_last_command/05_the_natives_of_wayland.cfg:36
#: scenarios/the_last_command/08_the_throne_room.cfg:38
msgid "Luke and Mara"
msgstr ""

#. [side]
#: scenarios/heir_to_the_empire/07_the_forest_crossing.cfg:66
msgid "Imperial Hunters"
msgstr ""

#. [unit]: id=sw_hte07_officer, type=sw_unit_im_officer
#: scenarios/heir_to_the_empire/07_the_forest_crossing.cfg:98
msgid "Lieutenant Krell"
msgstr ""

#. [side]
#: scenarios/heir_to_the_empire/07_the_forest_crossing.cfg:112
msgid "Vornskrs"
msgstr ""

#. [label]
#: scenarios/heir_to_the_empire/07_the_forest_crossing.cfg:158
msgid "Hyllyard City"
msgstr ""

#. [label]
#: scenarios/heir_to_the_empire/07_the_forest_crossing.cfg:162
msgid "Hunter's Cabin"
msgstr ""

#. [objective]: condition=win
#: scenarios/heir_to_the_empire/07_the_forest_crossing.cfg:167
msgid "Luke and Mara both reach Hyllyard City (the eastern edge)"
msgstr ""

#. [note]
#: scenarios/heir_to_the_empire/07_the_forest_crossing.cfg:177
msgid "Violet hexes are ysalamiri bubbles: Luke's Force abilities and deflection fail inside them. Vornskrs hunt Force-sensitives and hit Luke harder."
msgstr ""

#. [note]
#: scenarios/heir_to_the_empire/07_the_forest_crossing.cfg:180
msgid "Speeder bikes are fast in clearings and slow among the trees."
msgstr ""

#. [message]: speaker=sw_hero_mara
#: scenarios/heir_to_the_empire/07_the_forest_crossing.cfg:189
msgid "Don't get comfortable, Skywalker. The moment we're out of this forest, we settle things."
msgstr ""

#. [message]: speaker=sw_hero_luke
#: scenarios/heir_to_the_empire/07_the_forest_crossing.cfg:193
msgid "You keep saying that. You still haven't said why."
msgstr ""

#. [message]: speaker=sw_hero_mara
#: scenarios/heir_to_the_empire/07_the_forest_crossing.cfg:197
msgid "I have my reasons. Right now, I have Imperial scouts on bikes and a forest full of vornskrs. Walk."
msgstr ""

#. [message]: speaker=sw_hero_mara
#: scenarios/heir_to_the_empire/07_the_forest_crossing.cfg:210
msgid "Karrde keeps a comm relay here. I can call two of our people who are still in the forest. They'll help us. Not you. Us."
msgstr ""

#. [message]: speaker=sw_hero_luke
#: scenarios/heir_to_the_empire/07_the_forest_crossing.cfg:251
msgid "More bikes, coming in from the north."
msgstr ""

#. [message]: speaker=sw_hero_mara
#: scenarios/heir_to_the_empire/07_the_forest_crossing.cfg:284
msgid "They go for you because they can feel the Force in you. Karrde's tame ones do the same thing. Keep moving."
msgstr ""

#. [message]: speaker=sw_hero_luke
#: scenarios/heir_to_the_empire/07_the_forest_crossing.cfg:313
msgid "Hyllyard City. We made it. So, do we settle things now?"
msgstr ""

#. [message]: speaker=sw_hero_mara
#: scenarios/heir_to_the_empire/07_the_forest_crossing.cfg:317
msgid "Not today. Karrde will want to hear about this first. Next time, Skywalker."
msgstr ""

#. [side]: id=sw_hero_lando, type=sw_hero_lando
#. [scenario]: id=sw_hte_08_nomad_city
#: scenarios/heir_to_the_empire/08_nomad_city.cfg:52
#: scenarios/heir_to_the_empire/08_nomad_city.cfg:19
msgid "Nomad City"
msgstr ""

#. [part]
#: scenarios/heir_to_the_empire/08_nomad_city.cfg:32
msgid "On Nkllon, so close to its sun that the dayside would melt an unshielded ship, Lando Calrissian's Nomad City crawls across the surface, staying always in the planet's shadow and mining the rock as it goes."
msgstr ""

#. [part]
#: scenarios/heir_to_the_empire/08_nomad_city.cfg:35
msgid "Han brought word of Luke and the smugglers. While they talked, Imperial raiders landed on the sunside. They were not after the metals. They wanted Lando's mole miners."
msgstr ""

#. [side]: id=sw_hte08_harbid, type=sw_unit_im_officer
#: scenarios/heir_to_the_empire/08_nomad_city.cfg:70
msgid "Captain Harbid"
msgstr ""

#. [label]
#: scenarios/heir_to_the_empire/08_nomad_city.cfg:144
msgid "Mole Miner Shed"
msgstr ""

#. [label]
#: scenarios/heir_to_the_empire/08_nomad_city.cfg:158
msgid "Extraction"
msgstr ""

#. [objective]: condition=win
#: scenarios/heir_to_the_empire/08_nomad_city.cfg:163
msgid "Defeat Captain Harbid"
msgstr ""

#. [objective]: condition=win
#: scenarios/heir_to_the_empire/08_nomad_city.cfg:167
msgid "Hold out until the end of the last turn"
msgstr ""

#. [objective]: condition=lose
#: scenarios/heir_to_the_empire/08_nomad_city.cfg:171
msgid "Hijacked mole miners reach the extraction zone in the west"
msgstr ""

#. [note]
#: scenarios/heir_to_the_empire/08_nomad_city.cfg:181
msgid "Nkllon's sun: any unit ending its turn on open sand or dunes takes 4 damage. Rock outcrops and the city are shaded."
msgstr ""

#. [note]
#: scenarios/heir_to_the_empire/08_nomad_city.cfg:184
msgid "A raider who reaches a shed steals its mole miner. Hijacked miners head straight for the western edge."
msgstr ""

#. [message]: speaker=sw_hero_lando
#: scenarios/heir_to_the_empire/08_nomad_city.cfg:195
msgid "Raiders on the sunside, heading for the miner sheds. Somebody wants mole miners badly enough to cook their own troops getting here."
msgstr ""

#. [message]: speaker=sw_hero_han
#: scenarios/heir_to_the_empire/08_nomad_city.cfg:199
msgid "Mole miners? What does the Empire want with mining equipment?"
msgstr ""

#. [message]: speaker=sw_hero_lando
#: scenarios/heir_to_the_empire/08_nomad_city.cfg:203
msgid "I don't know, and I don't like not knowing. Keep them off the sheds, and don't stand around in the sun."
msgstr ""

#. [message]: speaker=sw_hero_lando
#: scenarios/heir_to_the_empire/08_nomad_city.cfg:269
msgid "They've got a mole miner out of the shed! Stop it before it reaches their landing zone!"
msgstr ""

#. [floating_text]
#: scenarios/heir_to_the_empire/08_nomad_city.cfg:296
msgid "Mole miner stolen"
msgstr ""

#. [message]: speaker=sw_hero_lando
#: scenarios/heir_to_the_empire/08_nomad_city.cfg:306
msgid "That's too many. Whatever they're planning, we just handed them the tools."
msgstr ""

#. [message]: speaker=unit
#: scenarios/heir_to_the_empire/08_nomad_city.cfg:322
msgid "Withdraw! Take what we have and withdraw!"
msgstr ""

#. [message]: speaker=sw_hero_han
#: scenarios/heir_to_the_empire/08_nomad_city.cfg:340
msgid "They're pulling out. Lando, how many miners did they get?"
msgstr ""

#. [message]: speaker=sw_hero_lando
#: scenarios/heir_to_the_empire/08_nomad_city.cfg:344
msgid "$sw_hte08_stolen| of them. And the shipyards at Sluis Van just sent a call for every pilot and miner crew we can spare: a whole relief fleet is docking there for refit."
msgstr ""

#. [message]: speaker=sw_hero_han
#: scenarios/heir_to_the_empire/08_nomad_city.cfg:348
msgid "Mole miners and a shipyard full of warships with skeleton crews. I think I know what they want them for."
msgstr ""

#. [scenario]: id=sw_hte_09_sluis_van_shipyards
#: scenarios/heir_to_the_empire/09_sluis_van_shipyards.cfg:16
msgid "The Sluis Van Shipyards"
msgstr ""

#. [part]
#: scenarios/heir_to_the_empire/09_sluis_van_shipyards.cfg:31
msgid "The Sluis Van shipyards are crowded with warships of a relief fleet, docked for refit with skeleton crews. Han's warning reached Rogue Squadron's commander, Wedge Antilles, only hours before the sensors lit up."
msgstr ""

#. [part]
#: scenarios/heir_to_the_empire/09_sluis_van_shipyards.cfg:34
msgid "Luke Skywalker, back from Myrkr, took his X-wing out with them."
msgstr ""

#. [side]: id=sw_hero_wedge, type=sw_hero_wedge
#: scenarios/heir_to_the_empire/09_sluis_van_shipyards.cfg:51
#: scenarios/heir_to_the_empire/10_thrawns_gambit.cfg:55
msgid "Sluis Van Defense"
msgstr ""

#. [side]
#: scenarios/heir_to_the_empire/09_sluis_van_shipyards.cfg:67
msgid "Imperial Strike Group"
msgstr ""

#. [event]
#: scenarios/heir_to_the_empire/09_sluis_van_shipyards.cfg:115
msgid "Corsair's Pride"
msgstr ""

#. [event]
#: scenarios/heir_to_the_empire/09_sluis_van_shipyards.cfg:116
#: scenarios/heir_to_the_empire/10_thrawns_gambit.cfg:142
msgid "Liberty's Hope"
msgstr ""

#. [event]
#: scenarios/heir_to_the_empire/09_sluis_van_shipyards.cfg:117
msgid "Kestrel"
msgstr ""

#. [event]
#: scenarios/heir_to_the_empire/09_sluis_van_shipyards.cfg:118
#: scenarios/heir_to_the_empire/10_thrawns_gambit.cfg:143
msgid "Valiant"
msgstr ""

#. [objective]: condition=win
#: scenarios/heir_to_the_empire/09_sluis_van_shipyards.cfg:135
msgid "Destroy every hijacked mole miner"
msgstr ""

#. [objective]: condition=lose
#: scenarios/heir_to_the_empire/09_sluis_van_shipyards.cfg:139
msgid "Two docked warships captured"
msgstr ""

#. [note]
#: scenarios/heir_to_the_empire/09_sluis_van_shipyards.cfg:149
msgid "Mole miners must reach a warship and cut into it at close range. Warships cannot fire back at them."
msgstr ""

#. [message]: speaker=sw_hero_wedge
#: scenarios/heir_to_the_empire/09_sluis_van_shipyards.cfg:183
msgid "Rogue Squadron, we have TIEs and something else on the scopes. Big, slow, and heading straight for the docks."
msgstr ""

#. [message]: speaker=sw_hero_luke
#: scenarios/heir_to_the_empire/09_sluis_van_shipyards.cfg:187
msgid "Mole miners. Han was right. They're going to cut into the warships and fly them out with boarding crews."
msgstr ""

#. [message]: speaker=sw_hero_wedge
#: scenarios/heir_to_the_empire/09_sluis_van_shipyards.cfg:191
msgid "Not today. Fighters, screen the docks. Bombers, go for the miners."
msgstr ""

#. [message]: speaker=sw_hero_wedge
#: scenarios/heir_to_the_empire/09_sluis_van_shipyards.cfg:226
msgid "Last group coming in. Take out those miners and this is over."
msgstr ""

#. [message]: speaker=sw_hero_wedge
#: scenarios/heir_to_the_empire/09_sluis_van_shipyards.cfg:254
msgid "That's the last mole miner. The docks are secure."
msgstr ""

#. [message]: speaker=sw_hero_luke
#: scenarios/heir_to_the_empire/09_sluis_van_shipyards.cfg:258
msgid "The docks, yes. But the Star Destroyers are still out there, and they haven't committed yet."
msgstr ""

#. [message]: speaker=sw_hero_wedge
#: scenarios/heir_to_the_empire/09_sluis_van_shipyards.cfg:282
msgid "They've cut into the $unit.name|! Boarding crews are aboard. We've lost her."
msgstr ""

#. [scenario]: id=sw_hte_10_thrawns_gambit
#: scenarios/heir_to_the_empire/10_thrawns_gambit.cfg:15
msgid "Thrawn's Gambit"
msgstr ""

#. [event]: id=sw_doctrine_grant_start
#: scenarios/heir_to_the_empire/10_thrawns_gambit.cfg:26
msgid "Recordings of New Republic victory celebrations, studied aboard the Chimaera, show how its commanders like to win."
msgstr ""

#. [part]
#: scenarios/heir_to_the_empire/10_thrawns_gambit.cfg:35
msgid "The mole miners failed. On the bridge of the Chimaera, Grand Admiral Thrawn watched the last of them break apart and did not seem disappointed."
msgstr ""

#. [part]
#: scenarios/heir_to_the_empire/10_thrawns_gambit.cfg:38
msgid "Then two Star Destroyers came forward out of the system's edge, launching fighters as they came. If the Empire could not steal the shipyard's warships, it would destroy them where they lay."
msgstr ""

#. [objective]: condition=win
#: scenarios/heir_to_the_empire/10_thrawns_gambit.cfg:165
msgid "Destroy the Judicator"
msgstr ""

#. [objective]: condition=win
#: scenarios/heir_to_the_empire/10_thrawns_gambit.cfg:169
msgid "Damage the Chimaera to half strength"
msgstr ""

#. [objective]: condition=win
#: scenarios/heir_to_the_empire/10_thrawns_gambit.cfg:173
msgid "Hold until the last turn with at least one warship intact"
msgstr ""

#. [objective]: condition=lose
#: scenarios/heir_to_the_empire/10_thrawns_gambit.cfg:177
msgid "Both warships destroyed"
msgstr ""

#. [note]
#: scenarios/heir_to_the_empire/10_thrawns_gambit.cfg:185
msgid "Star Destroyers are slow and heavily shielded but cannot dodge. Y-wing ion cannons slow them; proton torpedoes hit hard."
msgstr ""

#. [event]
#: scenarios/heir_to_the_empire/10_thrawns_gambit.cfg:192
msgid "Captain Pellaeon, launch all fighters. Their pilots are tired and their warships cannot move. Make them choose what to protect."
msgstr ""

#. [message]: speaker=sw_hero_wedge
#: scenarios/heir_to_the_empire/10_thrawns_gambit.cfg:195
msgid "Two Star Destroyers. All right, Rogues, the warships can't run, so neither can we."
msgstr ""

#. [message]: speaker=sw_hero_luke
#: scenarios/heir_to_the_empire/10_thrawns_gambit.cfg:199
msgid "Wedge, the second ship is holding back, covering the first. If we hurt one of them badly enough, I don't think he'll risk both."
msgstr ""

#. [message]: speaker=narrator
#: scenarios/heir_to_the_empire/10_thrawns_gambit.cfg:276
#: scenarios/the_last_command/10_the_last_command.cfg:195
msgid "Captain Pellaeon"
msgstr ""

#. [message]: speaker=narrator
#: scenarios/heir_to_the_empire/10_thrawns_gambit.cfg:277
msgid "Admiral, we've lost the initiative here. Shall I commit the reserve?"
msgstr ""

#. [event]
#: scenarios/heir_to_the_empire/10_thrawns_gambit.cfg:279
msgid "No, Captain. Withdraw. We have learned a great deal today about how the New Republic defends what it values. And the mole miners were only ever one way to get warships."
msgstr ""

#. [event]
#: scenarios/heir_to_the_empire/10_thrawns_gambit.cfg:280
msgid "Somewhere out there is a fleet of two hundred Dreadnaughts, lost before the Clone Wars ended. Find me the man who knows where it is."
msgstr ""

#. [message]: speaker=sw_hero_wedge
#: scenarios/heir_to_the_empire/10_thrawns_gambit.cfg:283
msgid "They're jumping out. Both of them. We held Sluis Van."
msgstr ""

#. [message]: speaker=sw_hero_luke
#: scenarios/heir_to_the_empire/10_thrawns_gambit.cfg:287
msgid "We held it because he let us. He was testing us, Wedge. This isn't over. I don't think it has even started."
msgstr ""

#. [scenario]: id=sw_tlc_01_the_siege_of_coruscant
#: scenarios/the_last_command/01_the_siege_of_coruscant.cfg:11
msgid "The Siege of Coruscant"
msgstr ""

#. [event]: id=sw_doctrine_grant_start
#: scenarios/the_last_command/01_the_siege_of_coruscant.cfg:22
msgid "Delta Source reports from inside the Imperial Palace describe the defence plans for Coruscant."
msgstr ""

#. [part]
#: scenarios/the_last_command/01_the_siege_of_coruscant.cfg:31
msgid "The Grand Admiral did not attack Coruscant. He did something worse. His ships slipped into orbit, released something, and left."
msgstr ""

#. [part]
#: scenarios/the_last_command/01_the_siege_of_coruscant.cfg:34
msgid "Sensors could find nothing. Then a freighter broke apart on an invisible rock, and the New Republic understood: the capital was surrounded by cloaked asteroids, and no one knew how many."
msgstr ""

#. [side]: id=sw_hero_wedge, type=sw_hero_wedge
#: scenarios/the_last_command/01_the_siege_of_coruscant.cfg:45
msgid "Coruscant Defense"
msgstr ""

#. [side]
#: scenarios/the_last_command/01_the_siege_of_coruscant.cfg:61
msgid "Imperial Minelaying Group"
msgstr ""

#. [unit]: id=sw_tlc01_minelayer_n, type=sw_unit_im_minelayer
#: scenarios/the_last_command/01_the_siege_of_coruscant.cfg:70
msgid "Minelayer Aurek"
msgstr ""

#. [unit]: id=sw_tlc01_minelayer_s, type=sw_unit_im_minelayer
#: scenarios/the_last_command/01_the_siege_of_coruscant.cfg:77
msgid "Minelayer Besh"
msgstr ""

#. [side]
#: scenarios/the_last_command/01_the_siege_of_coruscant.cfg:102
#: scenarios/the_last_command/09_bilbringi.cfg:82
msgid "Cloaked Asteroids"
msgstr ""

#. [objective]: condition=win
#: scenarios/the_last_command/01_the_siege_of_coruscant.cfg:141
msgid "Destroy both Imperial minelayers"
msgstr ""

#. [note]
#: scenarios/the_last_command/01_the_siege_of_coruscant.cfg:150
msgid "Cloaked asteroids are invisible. A ship that ends its turn next to one takes 8 damage. Each minelayer releases another asteroid every second turn."
msgstr ""

#. [message]: speaker=sw_hero_wedge
#: scenarios/the_last_command/01_the_siege_of_coruscant.cfg:161
msgid "We can't see the rocks, but we can see the ships dropping them. Two minelayers, east of the cordon."
msgstr ""

#. [message]: speaker=sw_hero_luke
#: scenarios/the_last_command/01_the_siege_of_coruscant.cfg:165
msgid "I can feel where some of the asteroids are, Wedge. Faintly. Fly where I fly."
msgstr ""

#. [message]: speaker=sw_hero_wedge
#: scenarios/the_last_command/01_the_siege_of_coruscant.cfg:210
msgid "Both minelayers down. The cordon stops growing. Now someone just has to sweep the rocks that are already up there."
msgstr ""

#. [scenario]: id=sw_tlc_02_the_smugglers_council
#: scenarios/the_last_command/02_the_smugglers_council.cfg:10
msgid "The Smugglers' Council"
msgstr ""

#. [part]
#: scenarios/the_last_command/02_the_smugglers_council.cfg:23
msgid "Talon Karrde had stayed neutral as long as neutrality paid. The Empire had stopped paying. He called the chiefs of the smuggling organizations to an old fortress on a dead world and asked them to choose a side."
msgstr ""

#. [part]
#: scenarios/the_last_command/02_the_smugglers_council.cfg:26
msgid "Someone among them had already chosen. The Imperial landing craft arrived before the first toast."
msgstr ""

#. [side]: id=sw_hero_karrde, type=sw_hero_karrde
#: scenarios/the_last_command/02_the_smugglers_council.cfg:37
msgid "Karrde's Organization"
msgstr ""

#. [side]: id=sw_tlc02_commander, type=sw_unit_im_officer
#: scenarios/the_last_command/02_the_smugglers_council.cfg:52
msgid "Imperial Raid"
msgstr ""

#. [side]: id=sw_tlc02_commander, type=sw_unit_im_officer
#: scenarios/the_last_command/02_the_smugglers_council.cfg:55
msgid "Colonel Mardek"
msgstr ""

#. [side]
#: scenarios/the_last_command/02_the_smugglers_council.cfg:78
msgid "Smuggler Chiefs"
msgstr ""

#. [side]
#: scenarios/the_last_command/02_the_smugglers_council.cfg:91
msgid "Mazzic"
msgstr ""

#. [side]
#: scenarios/the_last_command/02_the_smugglers_council.cfg:92
msgid "Ellor"
msgstr ""

#. [side]
#: scenarios/the_last_command/02_the_smugglers_council.cfg:93
msgid "Gillespee"
msgstr ""

#. [side]
#: scenarios/the_last_command/02_the_smugglers_council.cfg:94
msgid "Clyngunn"
msgstr ""

#. [side]
#: scenarios/the_last_command/02_the_smugglers_council.cfg:95
msgid "Par'tah"
msgstr ""

#. [objective]: condition=win
#: scenarios/the_last_command/02_the_smugglers_council.cfg:120
msgid "Hold the fortress until the last turn"
msgstr ""

#. [objective]: condition=win
#: scenarios/the_last_command/02_the_smugglers_council.cfg:124
msgid "Defeat Colonel Mardek"
msgstr ""

#. [objective]: condition=lose
#: scenarios/the_last_command/02_the_smugglers_council.cfg:128
msgid "Three smuggler chiefs killed"
msgstr ""

#. [objective]: condition=lose
#: scenarios/the_last_command/02_the_smugglers_council.cfg:132
msgid "Death of Karrde or Mara Jade"
msgstr ""

#. [message]: speaker=sw_tlc02_chief_1
#: scenarios/the_last_command/02_the_smugglers_council.cfg:143
msgid "Imperials! Karrde, you swore this place was clean!"
msgstr ""

#. [message]: speaker=sw_hero_karrde
#: scenarios/the_last_command/02_the_smugglers_council.cfg:147
msgid "It was, when I chose it. Someone at this table brought them. We'll find out who later. For now, the walls are thick and the doors are few."
msgstr ""

#. [message]: speaker=sw_hero_mara
#: scenarios/the_last_command/02_the_smugglers_council.cfg:151
msgid "I'll take the east gate. Try not to lose any chiefs while I'm busy."
msgstr ""

#. [message]: speaker=sw_hero_karrde
#: scenarios/the_last_command/02_the_smugglers_council.cfg:173
msgid "Too many of them are gone. There is no council left to save."
msgstr ""

#. [message]: speaker=sw_hero_karrde
#: scenarios/the_last_command/02_the_smugglers_council.cfg:203
msgid "The Empire tried to break us and failed. I think that settles the vote. Mara, send word to Coruscant: the smugglers are in."
msgstr ""

#. [message]: speaker=sw_hero_mara
#: scenarios/the_last_command/02_the_smugglers_council.cfg:207
msgid "And I'm going to Wayland. I know where the Emperor kept his storehouse. I was there once, a long time ago."
msgstr ""

#. [scenario]: id=sw_tlc_03_the_palace_infiltrators
#: scenarios/the_last_command/03_the_palace_infiltrators.cfg:13
msgid "The Palace Infiltrators"
msgstr ""

#. [part]
#: scenarios/the_last_command/03_the_palace_infiltrators.cfg:26
msgid "Leia's twins, Jacen and Jaina, were born in the Imperial Palace on Coruscant, behind more guards than any children in the galaxy."
msgstr ""

#. [part]
#: scenarios/the_last_command/03_the_palace_infiltrators.cfg:29
msgid "It was not enough. On a night when half the guard was at the orbital defenses, Imperial infiltrators came through the service corridors."
msgstr ""

#. [side]: id=sw_hero_leia, type=sw_hero_leia
#: scenarios/the_last_command/03_the_palace_infiltrators.cfg:40
msgid "Palace Guard"
msgstr ""

#. [side]
#: scenarios/the_last_command/03_the_palace_infiltrators.cfg:56
msgid "Imperial Infiltrators"
msgstr ""

#. [label]
#: scenarios/the_last_command/03_the_palace_infiltrators.cfg:100
msgid "Nursery"
msgstr ""

#. [objective]: condition=win
#: scenarios/the_last_command/03_the_palace_infiltrators.cfg:105
msgid "Defeat every infiltrator"
msgstr ""

#. [objective]: condition=lose
#: scenarios/the_last_command/03_the_palace_infiltrators.cfg:109
msgid "An infiltrator reaches the nursery"
msgstr ""

#. [note]
#: scenarios/the_last_command/03_the_palace_infiltrators.cfg:119
msgid "The Noghri now guard the Lady Vader: Noghri Commandos can be recruited."
msgstr ""

#. [message]: speaker=sw_hero_khabarakh
#: scenarios/the_last_command/03_the_palace_infiltrators.cfg:128
msgid "My lady. Movement in the service corridors. Not palace staff. They move the way we were trained to move."
msgstr ""

#. [message]: speaker=sw_hero_leia
#: scenarios/the_last_command/03_the_palace_infiltrators.cfg:132
msgid "They're after the twins. Chewie, the nursery door. Khabarakh, find them before they find us."
msgstr ""

#. [message]: speaker=sw_hero_leia
#: scenarios/the_last_command/03_the_palace_infiltrators.cfg:183
msgid "No!"
msgstr ""

#. [message]: speaker=sw_hero_leia
#: scenarios/the_last_command/03_the_palace_infiltrators.cfg:212
msgid "That's all of them. Han is going to hear about this the moment he lands, and then he'll want to go to Wayland too."
msgstr ""

#. [message]: speaker=sw_hero_khabarakh
#: scenarios/the_last_command/03_the_palace_infiltrators.cfg:216
msgid "Then we will all go, my lady. The Noghri have a debt to pay at Mount Tantiss."
msgstr ""

#. [scenario]: id=sw_tlc_04_landfall_on_wayland
#: scenarios/the_last_command/04_landfall_on_wayland.cfg:14
msgid "Landfall on Wayland"
msgstr ""

#. [part]
#: scenarios/the_last_command/04_landfall_on_wayland.cfg:27
msgid "Mara Jade remembered Wayland from the Emperor's service: a jungle world, a mountain, and inside the mountain a storehouse of everything the Emperor had wanted to keep."
msgstr ""

#. [part]
#: scenarios/the_last_command/04_landfall_on_wayland.cfg:30
msgid "She and Luke came in low and fast. Not low and fast enough. Their ship went down in the jungle a day's march from the mountain."
msgstr ""

#. [side]
#. [side]: id=sw_tlc06_commander, type=sw_unit_im_officer
#: scenarios/the_last_command/04_landfall_on_wayland.cfg:58
#: scenarios/the_last_command/06_the_gates_of_tantiss.cfg:51
msgid "Tantiss Garrison"
msgstr ""

#. [label]
#: scenarios/the_last_command/04_landfall_on_wayland.cfg:108
msgid "River Crossing"
msgstr ""

#. [objective]: condition=win
#: scenarios/the_last_command/04_landfall_on_wayland.cfg:113
msgid "Luke and Mara both reach the river crossing"
msgstr ""

#. [note]
#: scenarios/the_last_command/04_landfall_on_wayland.cfg:121
msgid "Garrison patrols arrive from the north and south edges on turns 5 and 9."
msgstr ""

#. [message]: speaker=sw_hero_mara
#: scenarios/the_last_command/04_landfall_on_wayland.cfg:132
msgid "Well, we're on Wayland. The mountain's east, past the river. The garrison will have seen us come down."
msgstr ""

#. [message]: speaker=sw_hero_luke
#: scenarios/the_last_command/04_landfall_on_wayland.cfg:136
msgid "Then we don't wait for them. Mara, I can sense C'baoth from here. He knows we're coming."
msgstr ""

#. [message]: speaker=sw_hero_mara
#: scenarios/the_last_command/04_landfall_on_wayland.cfg:180
msgid "Across. There are natives in these hills, and they don't like the garrison any more than we do."
msgstr ""

#. [scenario]: id=sw_tlc_05_the_natives_of_wayland
#: scenarios/the_last_command/05_the_natives_of_wayland.cfg:9
msgid "The Natives of Wayland"
msgstr ""

#. [part]
#: scenarios/the_last_command/05_the_natives_of_wayland.cfg:22
msgid "Wayland's two native peoples, the four-armed Myneyrshi and the armored Psadans, had no love for each other and less for anyone from off-world. The Emperor's garrison had taught them that."
msgstr ""

#. [part]
#: scenarios/the_last_command/05_the_natives_of_wayland.cfg:25
msgid "Mara had an idea for earning their trust: break the outpost that taxed their villages."
msgstr ""

#. [side]: id=sw_tlc05_commander, type=sw_unit_im_officer
#: scenarios/the_last_command/05_the_natives_of_wayland.cfg:52
msgid "Garrison Outpost"
msgstr ""

#. [side]: id=sw_tlc05_commander, type=sw_unit_im_officer
#: scenarios/the_last_command/05_the_natives_of_wayland.cfg:55
msgid "Captain Brasck"
msgstr ""

#. [side]
#: scenarios/the_last_command/05_the_natives_of_wayland.cfg:79
msgid "Wayland Natives"
msgstr ""

#. [objective]: condition=win
#: scenarios/the_last_command/05_the_natives_of_wayland.cfg:101
msgid "Defeat Captain Brasck at the garrison outpost"
msgstr ""

#. [note]
#: scenarios/the_last_command/05_the_natives_of_wayland.cfg:109
msgid "On turn 4 Wayland's natives, the Myneyrshi and the Psadans, join the fight against the garrison."
msgstr ""

#. [message]: speaker=sw_hero_mara
#: scenarios/the_last_command/05_the_natives_of_wayland.cfg:120
msgid "The outpost is east. The villages around it pay the garrison in food and labor, or they burn."
msgstr ""

#. [message]: speaker=sw_hero_luke
#: scenarios/the_last_command/05_the_natives_of_wayland.cfg:124
msgid "Then we start there. The villagers are watching us. Let's give them something worth seeing."
msgstr ""

#. [message]: speaker=narrator
#: scenarios/the_last_command/05_the_natives_of_wayland.cfg:148
msgid "Myneyrshi War Leader"
msgstr ""

#. [message]: speaker=narrator
#: scenarios/the_last_command/05_the_natives_of_wayland.cfg:149
msgid "Outsiders who fight the mountain's soldiers. Strange. The Psadans have come too. Strange again. We will fight beside you, today."
msgstr ""

#. [message]: speaker=sw_hero_luke
#: scenarios/the_last_command/05_the_natives_of_wayland.cfg:160
msgid "The outpost is ours. Mara, I've reached Han. He's bringing Leia, Lando, Chewie, and a shipload of Noghri."
msgstr ""

#. [message]: speaker=sw_hero_mara
#: scenarios/the_last_command/05_the_natives_of_wayland.cfg:164
msgid "Good. The natives know a way to the mountain's main gate. We'll need every one of them."
msgstr ""

#. [scenario]: id=sw_tlc_06_the_gates_of_tantiss
#: scenarios/the_last_command/06_the_gates_of_tantiss.cfg:9
msgid "The Gates of Mount Tantiss"
msgstr ""

#. [part]
#: scenarios/the_last_command/06_the_gates_of_tantiss.cfg:22
msgid "Han brought the Falcon in under the mountain's sensors with Leia, Lando, Chewbacca, and a team of Noghri commandos. The natives had shown them the road to the gate."
msgstr ""

#. [part]
#: scenarios/the_last_command/06_the_gates_of_tantiss.cfg:25
msgid "Inside, Luke and Mara were already climbing toward the throne room. Outside, someone had to bring down the shield."
msgstr ""

#. [side]: id=sw_hero_han, type=sw_hero_han
#: scenarios/the_last_command/06_the_gates_of_tantiss.cfg:36
#: scenarios/the_last_command/07_the_cloning_vats.cfg:34
msgid "Assault Team"
msgstr ""

#. [side]: id=sw_tlc06_commander, type=sw_unit_im_officer
#: scenarios/the_last_command/06_the_gates_of_tantiss.cfg:54
msgid "General Covell"
msgstr ""

#. [objective]: condition=win
#: scenarios/the_last_command/06_the_gates_of_tantiss.cfg:106
msgid "Destroy the shield generator at the mountain gate"
msgstr ""

#. [objective]: condition=lose
#: scenarios/the_last_command/06_the_gates_of_tantiss.cfg:110
msgid "Death of Han, Leia, Lando, Chewbacca, or Khabarakh"
msgstr ""

#. [message]: speaker=sw_hero_han
#: scenarios/the_last_command/06_the_gates_of_tantiss.cfg:126
msgid "That's the gate, and that's the shield generator beside it. Take it down and we can walk in."
msgstr ""

#. [message]: speaker=sw_hero_leia
#: scenarios/the_last_command/06_the_gates_of_tantiss.cfg:130
msgid "Luke's inside already. I can feel him, and something else. Something that feels like him and isn't."
msgstr ""

#. [message]: speaker=sw_hero_lando
#: scenarios/the_last_command/06_the_gates_of_tantiss.cfg:141
msgid "Shield's down! Gate's open!"
msgstr ""

#. [message]: speaker=sw_hero_han
#: scenarios/the_last_command/06_the_gates_of_tantiss.cfg:145
msgid "Chewie, Lando, with me. We're going for the cloning vats. Leia, keep the gate."
msgstr ""

#. [scenario]: id=sw_tlc_07_the_cloning_vats
#: scenarios/the_last_command/07_the_cloning_vats.cfg:10
msgid "The Cloning Vats"
msgstr ""

#. [part]
#: scenarios/the_last_command/07_the_cloning_vats.cfg:23
msgid "Deep in the mountain stood rows of tall glass cylinders, each one growing a soldier for the Grand Admiral's fleet."
msgstr ""

#. [side]
#: scenarios/the_last_command/07_the_cloning_vats.cfg:50
msgid "Vat Guards"
msgstr ""

#. [objective]: condition=win
#: scenarios/the_last_command/07_the_cloning_vats.cfg:109
msgid "Destroy all eight cloning cylinders"
msgstr ""

#. [objective]: condition=lose
#: scenarios/the_last_command/07_the_cloning_vats.cfg:113
msgid "Death of Han, Lando, or Chewbacca"
msgstr ""

#. [note]
#: scenarios/the_last_command/07_the_cloning_vats.cfg:117
msgid "Imperial Remnant clone reinforcements arrive on turns 5 and 9."
msgstr ""

#. [message]: speaker=sw_hero_lando
#: scenarios/the_last_command/07_the_cloning_vats.cfg:128
msgid "Han. Look at them. Rows of them. That's where the clones are coming from."
msgstr ""

#. [message]: speaker=sw_hero_han
#: scenarios/the_last_command/07_the_cloning_vats.cfg:132
msgid "Not after today. Wreck every one of those tanks."
msgstr ""

#. [message]: speaker=sw_hero_han
#: scenarios/the_last_command/07_the_cloning_vats.cfg:172
msgid "That's the last of them. Now let's find Luke before this mountain comes down on all of us."
msgstr ""

#. [scenario]: id=sw_tlc_08_the_throne_room
#: scenarios/the_last_command/08_the_throne_room.cfg:11
msgid "The Throne Room"
msgstr ""

#. [part]
#: scenarios/the_last_command/08_the_throne_room.cfg:24
msgid "At the heart of the mountain was the Emperor's throne room, and on the throne sat Joruus C'baoth."
msgstr ""

#. [part]
#: scenarios/the_last_command/08_the_throne_room.cfg:27
msgid "Beside him stood a young man with Luke Skywalker's face, holding a lightsaber that burned like Luke's. C'baoth had grown him from the hand Luke lost at Bespin."
msgstr ""

#. [unit]: id=sw_hero_luuke, type=sw_hero_luuke
#: scenarios/the_last_command/08_the_throne_room.cfg:71
msgid "Luuke"
msgstr ""

#. [objective]: condition=win
#: scenarios/the_last_command/08_the_throne_room.cfg:107
msgid "Defeat Joruus C'baoth and his clone Luuke"
msgstr ""

#. [note]
#: scenarios/the_last_command/08_the_throne_room.cfg:116
msgid "Mara brought a ysalamiri. Inside the violet hexes no one can use the Force: not Luke, not the clone, not C'baoth."
msgstr ""

#. [message]: speaker=sw_hero_cbaoth
#: scenarios/the_last_command/08_the_throne_room.cfg:125
msgid "Skywalker. You came back to me, as I said you would. Meet the apprentice you refused to be."
msgstr ""

#. [message]: speaker=sw_hero_luuke
#: scenarios/the_last_command/08_the_throne_room.cfg:129
msgid "..."
msgstr ""

#. [message]: speaker=sw_hero_mara
#: scenarios/the_last_command/08_the_throne_room.cfg:133
msgid "I know why I've wanted to kill you, Skywalker. It was never you. It was always him."
msgstr ""

#. [message]: speaker=sw_hero_luke
#: scenarios/the_last_command/08_the_throne_room.cfg:137
msgid "Then let's finish it. Together."
msgstr ""

#. [message]: speaker=sw_hero_mara
#: scenarios/the_last_command/08_the_throne_room.cfg:157
msgid "It's done. The voice that kept telling me to kill you is gone."
msgstr ""

#. [message]: speaker=sw_hero_luke
#: scenarios/the_last_command/08_the_throne_room.cfg:161
msgid "And the mountain is coming down. Let's go."
msgstr ""

#. [scenario]: id=sw_tlc_09_bilbringi
#: scenarios/the_last_command/09_bilbringi.cfg:11
msgid "The Bilbringi Shipyards"
msgstr ""

#. [part]
#: scenarios/the_last_command/09_bilbringi.cfg:26
msgid "With the cloning vats gone, the Grand Admiral could no longer grow new crews. The New Republic struck at the shipyards that built his ships."
msgstr ""

#. [side]: id=sw_hero_wedge, type=sw_hero_wedge
#: scenarios/the_last_command/09_bilbringi.cfg:37
#: scenarios/the_last_command/10_the_last_command.cfg:41
msgid "New Republic Strike Force"
msgstr ""

#. [side]: id=sw_tlc09_command, type=sw_unit_im_star_destroyer
#: scenarios/the_last_command/09_bilbringi.cfg:52
msgid "Bilbringi Command"
msgstr ""

#. [side]: id=sw_tlc09_command, type=sw_unit_im_star_destroyer
#: scenarios/the_last_command/09_bilbringi.cfg:55
msgid "Death's Head"
msgstr ""

#. [objective]: condition=win
#: scenarios/the_last_command/09_bilbringi.cfg:119
msgid "Destroy three shipyard platforms"
msgstr ""

#. [note]
#: scenarios/the_last_command/09_bilbringi.cfg:129
msgid "A screen of cloaked asteroids guards the yards. Ships that end their turn next to one take 8 damage."
msgstr ""

#. [message]: speaker=sw_hero_wedge
#: scenarios/the_last_command/09_bilbringi.cfg:140
msgid "He's using his own trick against us: an asteroid screen in front of the yards. Luke?"
msgstr ""

#. [message]: speaker=sw_hero_luke
#: scenarios/the_last_command/09_bilbringi.cfg:144
msgid "I can sense some of them. Follow my lead through the gaps."
msgstr ""

#. [message]: speaker=sw_hero_wedge
#: scenarios/the_last_command/09_bilbringi.cfg:166
msgid "Three platforms gone. The yards won't be building anything for a long time."
msgstr ""

#. [message]: speaker=sw_hero_luke
#: scenarios/the_last_command/09_bilbringi.cfg:170
msgid "Wedge, new contacts on the long-range scopes. The Chimaera. Thrawn is coming himself."
msgstr ""

#. [scenario]: id=sw_tlc_10_the_last_command
#: scenarios/the_last_command/10_the_last_command.cfg:12
msgid "The Last Command"
msgstr ""

#. [part]
#: scenarios/the_last_command/10_the_last_command.cfg:27
msgid "The Grand Admiral brought his fleet to Bilbringi to destroy the New Republic's strike force. It was a good plan. His plans were always good."
msgstr ""

#. [part]
#: scenarios/the_last_command/10_the_last_command.cfg:30
msgid "On the bridge of the Chimaera, his Noghri bodyguard Rukh stood behind him, as he always did. Rukh had heard from his own people what the Empire had done to Honoghr."
msgstr ""

#. [side]: id=sw_tlc10_escort_n, type=sw_unit_im_star_destroyer
#: scenarios/the_last_command/10_the_last_command.cfg:81
#: scenarios/the_last_command/10_the_last_command.cfg:84
msgid "Stormhawk"
msgstr ""

#. [side]: id=sw_tlc10_escort_s, type=sw_unit_im_star_destroyer
#: scenarios/the_last_command/10_the_last_command.cfg:98
#: scenarios/the_last_command/10_the_last_command.cfg:101
msgid "Nemesis"
msgstr ""

#. [objective]: condition=win
#: scenarios/the_last_command/10_the_last_command.cfg:132
msgid "Hold the line until the Imperial fleet breaks (turn 10)"
msgstr ""

#. [objective]: condition=win
#: scenarios/the_last_command/10_the_last_command.cfg:136
msgid "Destroy both escort Star Destroyers, Stormhawk and Nemesis"
msgstr ""

#. [event]
#: scenarios/the_last_command/10_the_last_command.cfg:149
msgid "Their formation favors the left. A habit from their pilots' training on Corellia. Captain, shift the screen."
msgstr ""

#. [message]: speaker=sw_hero_wedge
#: scenarios/the_last_command/10_the_last_command.cfg:152
msgid "He's reading us again. All right, Rogues: no habits today. Break and attack."
msgstr ""

#. [message]: speaker=narrator
#: scenarios/the_last_command/10_the_last_command.cfg:188
msgid "Bridge of the Chimaera"
msgstr ""

#. [message]: speaker=narrator
#: scenarios/the_last_command/10_the_last_command.cfg:189
msgid "Rukh stepped forward in silence. When it was over, the Grand Admiral sat back in his command chair and looked at the tactical display one last time."
msgstr ""

#. [event]
#: scenarios/the_last_command/10_the_last_command.cfg:191
msgid "The Noghri. Of course. Every culture shows itself in time... and I never studied my own guard."
msgstr ""

#. [message]: speaker=narrator
#: scenarios/the_last_command/10_the_last_command.cfg:196
msgid "Signal the fleet. All ships, disengage and withdraw to the rendezvous. ... That is an order."
msgstr ""

#. [message]: speaker=sw_hero_wedge
#: scenarios/the_last_command/10_the_last_command.cfg:200
msgid "They're breaking off. All of them. Luke, what just happened over there?"
msgstr ""

#. [message]: speaker=sw_hero_luke
#: scenarios/the_last_command/10_the_last_command.cfg:204
msgid "I don't know. But I felt it end. Whatever he was planning, it's over."
msgstr ""

