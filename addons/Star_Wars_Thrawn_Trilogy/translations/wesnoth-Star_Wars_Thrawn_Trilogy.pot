#. [part]
#: scenarios/dark_force_rising/01_the_noghri_prisoner.cfg:24
msgid "The Grand Admiral's fleet grows stronger every month, and the New Republic still does not know how he finds its people so easily."
msgstr ""

#. [part]
#: scenarios/dark_force_rising/01_the_noghri_prisoner.cfg:27
msgid "On Kashyyyk the Noghri come for Leia again. This time she means to take one of them alive and ask him why."
msgstr ""

#. [side]: id=sw_hero_leia, type=sw_hero_leia
#: scenarios/dark_force_rising/01_the_noghri_prisoner.cfg:38
#: scenarios/heir_to_the_empire/02_ambush_at_bpfassh.cfg:45
