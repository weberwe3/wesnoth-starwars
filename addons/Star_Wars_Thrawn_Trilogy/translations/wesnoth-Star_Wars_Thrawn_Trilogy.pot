msgstr ""

#. [side]: id=sw_dfr03_raid_boss, type=sw_unit_sm_veteran
#: scenarios/dark_force_rising/03_jomark.cfg:72
msgid "Raiders"
msgstr ""

#. [side]: id=sw_dfr03_raid_boss, type=sw_unit_sm_veteran
#: scenarios/dark_force_rising/03_jomark.cfg:75
msgid "Vorr Tannick"
msgstr ""

#. [label]
#: scenarios/dark_force_rising/03_jomark.cfg:121
msgid "C'baoth's Retreat"
msgstr ""

#. [objective]: condition=win
#: scenarios/dark_force_rising/03_jomark.cfg:126
msgid "Defeat the raid leader, Vorr Tannick"
msgstr ""

#. [objective]: condition=lose
#: scenarios/dark_force_rising/03_jomark.cfg:130
msgid "Two of the three lakeshore villages captured by raiders"
msgstr ""

#. [objective]: condition=lose
#: scenarios/dark_force_rising/03_jomark.cfg:134
#: scenarios/heir_to_the_empire/03_adrift.cfg:157
#: scenarios/heir_to_the_empire/05_prisoner_of_myrkr.cfg:174
msgid "Death of Luke Skywalker"
msgstr ""

#. [note]
#: scenarios/dark_force_rising/03_jomark.cfg:140
msgid "Jomark's villagers volunteer as militia. C'baoth fights as he sees fit."
msgstr ""

#. [message]: speaker=sw_hero_cbaoth
#: scenarios/dark_force_rising/03_jomark.cfg:149
msgid "Raiders, young Skywalker. Petty thieves who think the shore is undefended. Come, we shall show these people what Jedi are."
msgstr ""

#. [message]: speaker=sw_hero_luke
#: scenarios/dark_force_rising/03_jomark.cfg:153
msgid "Master C'baoth, the villagers can help. Let's keep them out of the fighting where we can."
msgstr ""

#. [message]: speaker=sw_hero_cbaoth
#: scenarios/dark_force_rising/03_jomark.cfg:157
msgid "The villagers are mine to protect, and mine to command. Do as you like with yours."
msgstr ""

#. [message]: speaker=sw_hero_cbaoth
#: scenarios/dark_force_rising/03_jomark.cfg:183
msgid "You have failed them, Skywalker. I will remember that."
msgstr ""

#. [message]: speaker=unit
#: scenarios/dark_force_rising/03_jomark.cfg:199
msgid "We yield! We yield! Take the cargo, just let us go!"
msgstr ""

#. [message]: speaker=sw_hero_cbaoth
#: scenarios/dark_force_rising/03_jomark.cfg:203
msgid "Yield? No. Let the lake have them."
msgstr ""

#. [message]: speaker=sw_hero_luke
#: scenarios/dark_force_rising/03_jomark.cfg:207
msgid "Master, they surrendered! That isn't... that isn't how the Jedi did things."
msgstr ""

#. [message]: speaker=sw_hero_cbaoth
#: scenarios/dark_force_rising/03_jomark.cfg:211
msgid "You know very little about how the Jedi did things, my young apprentice. That is why you are here."
msgstr ""

#. [scenario]: id=sw_dfr_04_the_senators_men
#: scenarios/dark_force_rising/04_the_senators_men.cfg:9
msgid "The Senator's Men"
msgstr ""

#. [part]
#: scenarios/dark_force_rising/04_the_senators_men.cfg:21
msgid "Han and Lando followed rumors of the lost Katana fleet from one smugglers' port to the next. Someone was always a step ahead of them."
msgstr ""

#. [part]
#: scenarios/dark_force_rising/04_the_senators_men.cfg:24
msgid "On a crowded spaceport world, the someone turned out to be Imperial Intelligence, and they were not interested in talking."
msgstr ""

#. [side]: id=sw_hero_han, type=sw_hero_han
#: scenarios/dark_force_rising/04_the_senators_men.cfg:35
msgid "Han and Lando"
msgstr ""

#. [side]: id=sw_hero_han, type=sw_hero_han
