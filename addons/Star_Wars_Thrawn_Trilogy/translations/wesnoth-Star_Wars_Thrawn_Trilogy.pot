#. [unit]: id=sw_hero_khabarakh, type=sw_hero_khabarakh
#. [event]
#: scenarios/dark_force_rising/01_the_noghri_prisoner.cfg:69
#: scenarios/dark_force_rising/02_honoghr.cfg:93
#: scenarios/dark_force_rising/10_honoghrs_choice.cfg:104
#: scenarios/the_last_command/03_the_palace_infiltrators.cfg:84
#: scenarios/the_last_command/06_the_gates_of_tantiss.cfg:101
msgid "Khabarakh"
msgstr ""

#. [event]
#: scenarios/dark_force_rising/01_the_noghri_prisoner.cfg:101
#: scenarios/dark_force_rising/02_honoghr.cfg:92
#: scenarios/dark_force_rising/08_aboard_the_katana.cfg:109
#: scenarios/dark_force_rising/10_honoghrs_choice.cfg:103
#: scenarios/heir_to_the_empire/02_ambush_at_bpfassh.cfg:146
#: scenarios/heir_to_the_empire/04_shadows_of_kashyyyk.cfg:137
#: scenarios/the_last_command/03_the_palace_infiltrators.cfg:83
#: scenarios/the_last_command/06_the_gates_of_tantiss.cfg:100
#: scenarios/the_last_command/07_the_cloning_vats.cfg:104
msgid "Chewbacca"
msgstr ""

#. [objective]: condition=win
#: scenarios/dark_force_rising/01_the_noghri_prisoner.cfg:105
msgid "Capture Khabarakh: reduce him to a third of his hit points or less"
msgstr ""

#. [objective]: condition=lose
#: scenarios/dark_force_rising/01_the_noghri_prisoner.cfg:109
msgid "Death of Khabarakh"
msgstr ""

#. [objective]: condition=lose
#: scenarios/dark_force_rising/01_the_noghri_prisoner.cfg:113
#: scenarios/heir_to_the_empire/04_shadows_of_kashyyyk.cfg:157
msgid "Death of Leia or Chewbacca"
msgstr ""

#. [note]
#: scenarios/dark_force_rising/01_the_noghri_prisoner.cfg:119
msgid "Wookiee Lookouts reveal Noghri within two hexes."
msgstr ""

#. [message]: speaker=sw_hero_leia
#: scenarios/dark_force_rising/01_the_noghri_prisoner.cfg:128
msgid "They're here again. I can feel it, the same way I felt them on Bpfassh."
msgstr ""

#. [message]: speaker=sw_hero_chewbacca
#: scenarios/dark_force_rising/01_the_noghri_prisoner.cfg:132
msgid "<i>(Chewbacca growls low and long.)</i>"
msgstr ""

#. [message]: speaker=sw_hero_leia
#: scenarios/dark_force_rising/01_the_noghri_prisoner.cfg:136
msgid "No, Chewie. Not this time. I want one of them alive. Their leader, if we can manage it."
msgstr ""

#. [message]: speaker=sw_hero_khabarakh
#: scenarios/dark_force_rising/01_the_noghri_prisoner.cfg:197
msgid "Enough. I yield, and I will answer you. But not here, with my team watching from the trees."
msgstr ""

#. [message]: speaker=sw_hero_leia
#: scenarios/dark_force_rising/01_the_noghri_prisoner.cfg:201
msgid "Then we'll talk in private. Chewie, call the others off."
msgstr ""

#. [scenario]: id=sw_dfr_02_honoghr
#: scenarios/dark_force_rising/02_honoghr.cfg:9
msgid "Honoghr"
msgstr ""

#. [part]
#: scenarios/dark_force_rising/02_honoghr.cfg:21
msgid "Khabarakh would say only that the answers were on his homeworld, and that he would take Leia there if she came without soldiers."
msgstr ""

#. [part]
#: scenarios/dark_force_rising/02_honoghr.cfg:24
msgid "Honoghr is brown from horizon to horizon. Nothing green grows there. Imperial droids crawl over the fields, cleaning a poison that never seems to leave."
msgstr ""

#. [side]: id=sw_hero_leia, type=sw_hero_leia
#: scenarios/dark_force_rising/02_honoghr.cfg:35
msgid "Leia's Party"
msgstr ""

#. [side]
#: scenarios/dark_force_rising/02_honoghr.cfg:52
msgid "Imperial Overseers"
msgstr ""

#. [label]
#: scenarios/dark_force_rising/02_honoghr.cfg:96
#: scenarios/dark_force_rising/10_honoghrs_choice.cfg:107
msgid "Clan House of Nystao"
msgstr ""

#. [objective]: condition=win
#: scenarios/dark_force_rising/02_honoghr.cfg:105
msgid "Leia reaches the clan house at Nystao"
msgstr ""

#. [objective]: condition=lose
#: scenarios/dark_force_rising/02_honoghr.cfg:109
#: scenarios/dark_force_rising/10_honoghrs_choice.cfg:120
#: scenarios/the_last_command/03_the_palace_infiltrators.cfg:112
msgid "Death of Leia, Chewbacca, or Khabarakh"
msgstr ""

#. [note]
#: scenarios/dark_force_rising/02_honoghr.cfg:114
msgid "The decontamination droids stay at their posts until someone comes within reach. Avoid open ground near them."
msgstr ""

#. [message]: speaker=sw_hero_khabarakh
#: scenarios/dark_force_rising/02_honoghr.cfg:123
msgid "The Empire watches the plain with its droids. They do not look for us; we are their servants. They will look for you."
msgstr ""

#. [message]: speaker=sw_hero_leia
#: scenarios/dark_force_rising/02_honoghr.cfg:127
msgid "Then we keep to the hills and the riverbed. How far to your clan house?"
msgstr ""

#. [message]: speaker=sw_hero_khabarakh
#: scenarios/dark_force_rising/02_honoghr.cfg:131
msgid "Across the plain, to Nystao. The maitrakh of my clan will decide what happens to you there. And to me."
msgstr ""

#. [message]: speaker=sw_hero_leia
#: scenarios/dark_force_rising/02_honoghr.cfg:142
msgid "Those are the droids. They've been working this ground for forty years? Something doesn't add up."
msgstr ""

#. [message]: speaker=narrator
#: scenarios/dark_force_rising/02_honoghr.cfg:154
#: scenarios/dark_force_rising/02_honoghr.cfg:164
#: scenarios/dark_force_rising/10_honoghrs_choice.cfg:191
msgid "Maitrakh of Clan Kihm'bar"
msgstr ""

#. [message]: speaker=narrator
#: scenarios/dark_force_rising/02_honoghr.cfg:156
msgid "Khabarakh, you bring a human into the dukha? ... Wait. That scent. It is the scent of the Lord Vader himself."
msgstr ""

#. [message]: speaker=sw_hero_leia
#: scenarios/dark_force_rising/02_honoghr.cfg:160
msgid "Darth Vader was my father. I didn't come to claim anything from you. I came to understand."
msgstr ""

#. [message]: speaker=narrator
#: scenarios/dark_force_rising/02_honoghr.cfg:166
msgid "Then stay hidden, Lady Vader, and listen. You will hear things that we ourselves do not wish to hear."
msgstr ""

#. [scenario]: id=sw_dfr_03_jomark
#: scenarios/dark_force_rising/03_jomark.cfg:11
msgid "Jomark"
msgstr ""

#. [part]
#: scenarios/dark_force_rising/03_jomark.cfg:23
msgid "A message reached Luke on Coruscant: a Jedi Master of the Old Republic was alive, living quietly on the lake world Jomark, and wished to meet him."
msgstr ""

#. [part]
#: scenarios/dark_force_rising/03_jomark.cfg:26
msgid "Joruus C'baoth was everything Luke had hoped for, and something more that he could not yet name. On Luke's first morning, raiders landed on the eastern shore."
msgstr ""

