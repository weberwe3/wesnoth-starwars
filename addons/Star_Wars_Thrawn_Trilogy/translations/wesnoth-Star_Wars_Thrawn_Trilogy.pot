#. [campaign]: id=Star_Wars_Thrawn_Trilogy_The_Last_Command
#: _main.cfg:147
msgid ""
"Thrawn besieges Coruscant with invisible asteroids. Karrde rallies the smugglers. Luke and Mara Jade descend on Wayland, where the Emperor's storehouse hides the Grand Admiral's cloning vats and the mad Jedi C'baoth waits with a clone of Luke.\n"
"\n"
"Campaign III of an original, fan-made Thrawn Trilogy total conversion. Ten missions."
msgstr ""

#. [scenario]: id=sw_dfr_01_the_noghri_prisoner
#: scenarios/dark_force_rising/01_the_noghri_prisoner.cfg:11
msgid "The Noghri Prisoner"
msgstr ""

#. [part]
#: scenarios/dark_force_rising/01_the_noghri_prisoner.cfg:23
msgid "The Grand Admiral's fleet grows stronger every month, and the New Republic still does not know how he finds its people so easily."
msgstr ""

#. [part]
#: scenarios/dark_force_rising/01_the_noghri_prisoner.cfg:26
msgid "On Kashyyyk the Noghri come for Leia again. This time she means to take one of them alive and ask him why."
msgstr ""

#. [side]: id=sw_hero_leia, type=sw_hero_leia
#: scenarios/dark_force_rising/01_the_noghri_prisoner.cfg:37
