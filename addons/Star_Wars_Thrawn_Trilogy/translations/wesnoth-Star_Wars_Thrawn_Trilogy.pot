#. [attack]: type=pierce
#: units/spacecraft.cfg:165
msgid "proton torpedo bombs"
msgstr ""

#. [attack]: type=impact
#: units/spacecraft.cfg:175
msgid "heavy laser cannons"
msgstr ""

#. [defense]
#: units/spacecraft.cfg:200
