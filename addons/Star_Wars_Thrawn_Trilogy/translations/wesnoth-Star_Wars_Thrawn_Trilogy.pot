#. [message]: speaker=sw_hero_han
#: scenarios/dark_force_rising/04_the_senators_men.cfg:156
msgid "Then we go through the middle. The Falcon's at the north pad. Stay low."
msgstr ""

#. [unit]: id=sw_dfr04_irenez, type=sw_unit_bi_commando
#: scenarios/dark_force_rising/04_the_senators_men.cfg:166
msgid "Captain Irenez"
msgstr ""

#. [message]: speaker=sw_dfr04_irenez
#: scenarios/dark_force_rising/04_the_senators_men.cfg:189
msgid "Captain Solo, the Senator sends his regards. We'll hold the north street. Get to your ship."
msgstr ""

#. [message]: speaker=sw_hero_han
#: scenarios/dark_force_rising/04_the_senators_men.cfg:193
msgid "Senator? Which senator?"
msgstr ""

#. [message]: speaker=sw_dfr04_irenez
#: scenarios/dark_force_rising/04_the_senators_men.cfg:197
msgid "One you used to know. He'll explain, if you live long enough to meet him."
msgstr ""

#. [message]: speaker=sw_hero_lando
#: scenarios/dark_force_rising/04_the_senators_men.cfg:209
msgid "Those commandos are signaling. They want us to follow them out-system."
msgstr ""

#. [message]: speaker=sw_hero_han
#: scenarios/dark_force_rising/04_the_senators_men.cfg:213
msgid "Then we follow. Carefully."
msgstr ""

#. [scenario]: id=sw_dfr_05_peregrines_nest
#: scenarios/dark_force_rising/05_peregrines_nest.cfg:9
msgid "The Peregrine's Nest"
msgstr ""

#. [part]
#: scenarios/dark_force_rising/05_peregrines_nest.cfg:24
msgid "Senator Garm Bel Iblis had left the Rebellion years before Endor, unwilling to trade one ruler for another. Since then he had fought the Empire alone, with a private army and a fleet of Dreadnaughts."
msgstr ""

#. [part]
#: scenarios/dark_force_rising/05_peregrines_nest.cfg:28
msgid "He knew about the Katana fleet too. Before he could say how much, the Empire found his base."
msgstr ""

#. [side]: id=sw_hero_han, type=sw_hero_han
#: scenarios/dark_force_rising/05_peregrines_nest.cfg:39
msgid "Bel Iblis's Base"
msgstr ""

#. [side]: id=sw_dfr05_commander, type=sw_unit_im_officer
#: scenarios/dark_force_rising/05_peregrines_nest.cfg:54
msgid "Imperial Assault"
msgstr ""

#. [side]: id=sw_dfr05_commander, type=sw_unit_im_officer
#: scenarios/dark_force_rising/05_peregrines_nest.cfg:57
msgid "Major Tierce"
msgstr ""

#. [event]
#: scenarios/dark_force_rising/05_peregrines_nest.cfg:96
#: scenarios/dark_force_rising/09_battle_for_the_fleet.cfg:336
msgid "Garm Bel Iblis"
msgstr ""

#. [label]
#. [unit_type]: id=sw_unit_ob_shield_generator, race=mechanical
#: scenarios/dark_force_rising/05_peregrines_nest.cfg:124
#: units/tlc_units.cfg:1479
msgid "Shield Generator"
msgstr ""

#. [objective]: condition=win
#: scenarios/dark_force_rising/05_peregrines_nest.cfg:129
msgid "Hold the shield generator through the last turn"
msgstr ""

#. [objective]: condition=win
#: scenarios/dark_force_rising/05_peregrines_nest.cfg:133
msgid "Defeat Major Tierce"
msgstr ""

#. [objective]: condition=lose
#: scenarios/dark_force_rising/05_peregrines_nest.cfg:137
msgid "An Imperial unit reaches the shield generator"
msgstr ""

#. [note]
#: scenarios/dark_force_rising/05_peregrines_nest.cfg:145
msgid "If Lando or Bel Iblis falls, that hero withdraws from the fight badly wounded and returns for the next mission."
msgstr ""

#. [objectives]
#: scenarios/dark_force_rising/05_peregrines_nest.cfg:150
msgid "Keep Garm Bel Iblis in the fight to the end"
msgstr ""

#. [message]: speaker=sw_hero_bel_iblis
#: scenarios/dark_force_rising/05_peregrines_nest.cfg:162
msgid "So the Grand Admiral has found my nest. Captain Solo, I'd hoped to make my introductions over a drink."
msgstr ""

#. [message]: speaker=sw_hero_han
#: scenarios/dark_force_rising/05_peregrines_nest.cfg:166
msgid "We'll do the drink after. What do you need?"
msgstr ""

#. [message]: speaker=sw_hero_bel_iblis
#: scenarios/dark_force_rising/05_peregrines_nest.cfg:170
msgid "The shield generator. If it falls, their walkers will flatten this base before my ships can lift. Hold the canyon mouth."
msgstr ""

#. [message]: speaker=sw_hero_bel_iblis
#: scenarios/dark_force_rising/05_peregrines_nest.cfg:182
msgid "They're at the generator. Abandon the base!"
msgstr ""

#. [message]: speaker=sw_hero_bel_iblis
#: scenarios/dark_force_rising/05_peregrines_nest.cfg:210
msgid "They're falling back. Well fought. Now, about the Katana fleet: I know where it is not. Someone else claims to know where it is."
msgstr ""

#. [message]: speaker=sw_hero_lando
#: scenarios/dark_force_rising/05_peregrines_nest.cfg:214
msgid "Let me guess. Someone who'll want paying."
msgstr ""

#. [part]
#: scenarios/dark_force_rising/06_the_mad_jedi.cfg:29
msgid "Weeks on Jomark taught Luke more about C'baoth than about the Force. The old man wanted an apprentice to shape, and he meant to shape Luke whether Luke agreed or not."
msgstr ""

#. [part]
#: scenarios/dark_force_rising/06_the_mad_jedi.cfg:33
msgid "When Luke tried to leave, the sky over the lake turned black."
msgstr ""

#. [label]
#: scenarios/dark_force_rising/06_the_mad_jedi.cfg:144
msgid "Mara's Ship"
msgstr ""

#. [objective]: condition=win
#: scenarios/dark_force_rising/06_the_mad_jedi.cfg:149
msgid "Luke reaches Mara Jade's ship"
msgstr ""

#. [objective]: condition=lose
#: scenarios/dark_force_rising/06_the_mad_jedi.cfg:153
msgid "Death of Luke or Mara"
msgstr ""

#. [note]
#: scenarios/dark_force_rising/06_the_mad_jedi.cfg:158
msgid "C'baoth cannot be defeated here. Every second turn his Force storm strikes part of the map."
msgstr ""

#. [note]
#: scenarios/dark_force_rising/06_the_mad_jedi.cfg:161
msgid "The villagers attacking you are under C'baoth's influence."
msgstr ""

#. [message]: speaker=sw_hero_cbaoth
#: scenarios/dark_force_rising/06_the_mad_jedi.cfg:171
msgid "You will not leave Jomark, Skywalker. You have not finished learning."
msgstr ""

#. [message]: speaker=sw_hero_luke
#: scenarios/dark_force_rising/06_the_mad_jedi.cfg:175
msgid "I've learned enough. You don't want an apprentice, you want a servant."
msgstr ""

#. [event]
#. [unit]: id=sw_hte05_mara, type=sw_hero_mara
#. [message]: speaker=narrator
#: scenarios/dark_force_rising/06_the_mad_jedi.cfg:181
#: scenarios/heir_to_the_empire/05_prisoner_of_myrkr.cfg:351
#: scenarios/heir_to_the_empire/05_prisoner_of_myrkr.cfg:396
#: scenarios/heir_to_the_empire/07_the_forest_crossing.cfg:157
#: scenarios/the_last_command/02_the_smugglers_council.cfg:123
#: scenarios/the_last_command/04_landfall_on_wayland.cfg:108
#: scenarios/the_last_command/05_the_natives_of_wayland.cfg:101
#: scenarios/the_last_command/08_the_throne_room.cfg:123
msgid "Mara Jade"
msgstr ""

#. [message]: speaker=sw_hero_mara
#: scenarios/dark_force_rising/06_the_mad_jedi.cfg:184
msgid "Skywalker! Karrde sent me to warn you about this lunatic. Looks like I'm late. My ship's on the east shore. Move."
msgstr ""

#. [message]: speaker=sw_hero_luke
#: scenarios/dark_force_rising/06_the_mad_jedi.cfg:188
msgid "Mara? I thought you wanted me dead."
msgstr ""

#. [message]: speaker=sw_hero_mara
#: scenarios/dark_force_rising/06_the_mad_jedi.cfg:192
msgid "I do. By my hand, not his. Now move!"
msgstr ""

#. [message]: speaker=sw_hero_cbaoth
#: scenarios/dark_force_rising/06_the_mad_jedi.cfg:234
msgid "Feel the storm, boy!"
msgstr ""

#. [message]: speaker=sw_hero_mara
#: scenarios/dark_force_rising/06_the_mad_jedi.cfg:258
msgid "Strap in. And don't think this makes us friends."
msgstr ""

#. [message]: speaker=sw_hero_cbaoth
#: scenarios/dark_force_rising/06_the_mad_jedi.cfg:262
msgid "Run, then. You will come back to me, Skywalker. All Jedi come back to me in the end."
msgstr ""

#. [message]: speaker=sw_hero_luke
#: scenarios/dark_force_rising/06_the_mad_jedi.cfg:273
msgid "I can't fly this ship myself, and I'm not leaving Mara behind."
msgstr ""

#. [message]: speaker=sw_hero_cbaoth
#: scenarios/dark_force_rising/06_the_mad_jedi.cfg:324
msgid "No. Not dead. Broken, and then remade. You will thank me for it, Skywalker."
msgstr ""

#. [message]: speaker=unit
#: scenarios/dark_force_rising/06_the_mad_jedi.cfg:330
#: utils/hte_macros.cfg:137
msgid "I can't go on..."
msgstr ""

#. [part]
#: scenarios/dark_force_rising/07_the_dark_force.cfg:45
msgid "Talon Karrde sold the location of the Katana fleet to the New Republic. He had already sold it to someone else, who had sold it to the Grand Admiral."
msgstr ""

#. [part]
#: scenarios/dark_force_rising/07_the_dark_force.cfg:49
msgid "Two hundred Dreadnaughts drift in the dark, their crews long dead. Whoever docks with them first can fly them home."
msgstr ""

#. [side]: id=sw_hero_wedge, type=sw_hero_wedge
#: scenarios/dark_force_rising/07_the_dark_force.cfg:60
#: scenarios/dark_force_rising/09_battle_for_the_fleet.cfg:41
msgid "New Republic Task Force"
msgstr ""

#. [side]: id=sw_hero_wedge, type=sw_hero_wedge
#: scenarios/dark_force_rising/07_the_dark_force.cfg:63
#: scenarios/dark_force_rising/09_battle_for_the_fleet.cfg:44
#: scenarios/heir_to_the_empire/09_sluis_van_shipyards.cfg:57
#: scenarios/heir_to_the_empire/10_thrawns_gambit.cfg:61
#: scenarios/the_last_command/01_the_siege_of_coruscant.cfg:51
#: scenarios/the_last_command/09_bilbringi.cfg:44
#: scenarios/the_last_command/10_the_last_command.cfg:46
msgid "Wedge Antilles"
msgstr ""

#. [side]: id=sw_dfr07_carrier, type=sw_unit_im_star_destroyer
#: scenarios/dark_force_rising/07_the_dark_force.cfg:75
msgid "Imperial Boarding Force"
msgstr ""

#. [side]: id=sw_dfr07_carrier, type=sw_unit_im_star_destroyer
#: scenarios/dark_force_rising/07_the_dark_force.cfg:78
msgid "Peremptory"
msgstr ""

#. [side]
#: scenarios/dark_force_rising/07_the_dark_force.cfg:95
msgid "Katana Fleet (derelict)"
msgstr ""

#. [objective]: condition=win
#: scenarios/dark_force_rising/07_the_dark_force.cfg:155
msgid "Secure three Dreadnaughts (move a Boarding Shuttle next to one)"
msgstr ""

#. [objective]: condition=lose
#: scenarios/dark_force_rising/07_the_dark_force.cfg:159
msgid "The Empire secures four Dreadnaughts"
msgstr ""

#. [objective]: condition=lose
#: scenarios/dark_force_rising/07_the_dark_force.cfg:163
#: scenarios/dark_force_rising/09_battle_for_the_fleet.cfg:167
#: scenarios/heir_to_the_empire/09_sluis_van_shipyards.cfg:146
#: scenarios/heir_to_the_empire/10_thrawns_gambit.cfg:184
#: scenarios/the_last_command/01_the_siege_of_coruscant.cfg:148
#: scenarios/the_last_command/09_bilbringi.cfg:127
#: scenarios/the_last_command/10_the_last_command.cfg:142
msgid "Death of Wedge Antilles"
msgstr ""

#. [note]
#: scenarios/dark_force_rising/07_the_dark_force.cfg:167
#: scenarios/dark_force_rising/09_battle_for_the_fleet.cfg:171
#: scenarios/heir_to_the_empire/09_sluis_van_shipyards.cfg:150
#: scenarios/heir_to_the_empire/10_thrawns_gambit.cfg:188
#: scenarios/the_last_command/01_the_siege_of_coruscant.cfg:152
#: scenarios/the_last_command/09_bilbringi.cfg:131
#: scenarios/the_last_command/10_the_last_command.cfg:146
msgid "If Luke falls, he withdraws from the fight badly wounded and returns for the next mission."
msgstr ""

#. [note]
#: scenarios/dark_force_rising/07_the_dark_force.cfg:172
msgid "Imperial assault shuttles race for the same ships. Shoot them down before they dock."
msgstr ""

#. [message]: speaker=sw_hero_wedge
#: scenarios/dark_force_rising/07_the_dark_force.cfg:182
msgid "There they are. Dreadnaughts, dozens of them, all in a line. And a Star Destroyer already launching shuttles."
msgstr ""

#. [message]: speaker=sw_hero_luke
#: scenarios/dark_force_rising/07_the_dark_force.cfg:186
msgid "Fighters, screen our shuttles. Boarding crews, dock with anything you can reach."
msgstr ""

#. [floating_text]
#: scenarios/dark_force_rising/07_the_dark_force.cfg:253
msgid "Dreadnaught secured"
msgstr ""

#. [message]: speaker=sw_hero_wedge
#: scenarios/dark_force_rising/07_the_dark_force.cfg:266
msgid "Three Dreadnaughts are ours and answering their helms. That's our share of the Dark Force, people."
msgstr ""

#. [message]: speaker=sw_hero_luke
#: scenarios/dark_force_rising/07_the_dark_force.cfg:270
msgid "Wedge, the flagship is still unclaimed. If its slave circuits are intact, it controls the rest. I'm taking a team aboard."
msgstr ""

#. [message]: speaker=sw_hero_wedge
#: scenarios/dark_force_rising/07_the_dark_force.cfg:287
msgid "They've got too many of them. Pull back!"
msgstr ""

#. [part]
#: scenarios/dark_force_rising/08_aboard_the_katana.cfg:24
msgid "The Katana herself, flagship of the lost fleet, still hung at the head of the line. Imperial assault shuttles had reached her first."
msgstr ""

#. [part]
#: scenarios/dark_force_rising/08_aboard_the_katana.cfg:28
msgid "The soldiers inside did not move like ordinary stormtroopers. They moved like one man, copied many times."
msgstr ""

#. [side]: id=sw_hero_luke, type=sw_hero_luke
#: scenarios/dark_force_rising/08_aboard_the_katana.cfg:39
msgid "Boarding Party"
msgstr ""

#. [side]
#: scenarios/dark_force_rising/08_aboard_the_katana.cfg:55
msgid "Clone Boarding Troops"
msgstr ""

#. [unit]: id=sw_dfr08_clone_officer, type=sw_unit_im_stormtrooper_sergeant
#: scenarios/dark_force_rising/08_aboard_the_katana.cfg:89
msgid "Clone Commander"
msgstr ""

#. [label]
#: scenarios/dark_force_rising/08_aboard_the_katana.cfg:116
msgid "Bridge"
msgstr ""

#. [objective]: condition=win
#: scenarios/dark_force_rising/08_aboard_the_katana.cfg:121
msgid "Luke reaches the Katana's bridge"
msgstr ""

#. [objective]: condition=lose
#: scenarios/dark_force_rising/08_aboard_the_katana.cfg:125
#: scenarios/heir_to_the_empire/07_the_forest_crossing.cfg:188
#: scenarios/the_last_command/04_landfall_on_wayland.cfg:120
#: scenarios/the_last_command/05_the_natives_of_wayland.cfg:109
#: scenarios/the_last_command/08_the_throne_room.cfg:132
msgid "Death of Luke"
msgstr ""

#. [note]
#: scenarios/dark_force_rising/08_aboard_the_katana.cfg:129
msgid "If Han, Lando or Chewbacca falls, that hero withdraws from the fight badly wounded and returns for the next mission."
msgstr ""

#. [note]
#: scenarios/dark_force_rising/08_aboard_the_katana.cfg:132
msgid "Clone trooper reinforcements board the Katana on turns 5 and 9."
msgstr ""

#. [objectives]
#: scenarios/dark_force_rising/08_aboard_the_katana.cfg:136
msgid "Keep Han Solo, Lando Calrissian and Chewbacca in the fight to the end"
msgstr ""

#. [message]: speaker=sw_hero_han
#: scenarios/dark_force_rising/08_aboard_the_katana.cfg:144
msgid "Imperials got here first. How many of them are there?"
msgstr ""

#. [message]: speaker=sw_hero_luke
#: scenarios/dark_force_rising/08_aboard_the_katana.cfg:148
msgid "Han, I can barely feel them. It's like they're all the same person."
msgstr ""

#. [message]: speaker=sw_hero_lando
#: scenarios/dark_force_rising/08_aboard_the_katana.cfg:152
msgid "Clones. That's how he's been filling all those new ships so fast. We need that bridge."
msgstr ""

#. [message]: speaker=sw_hero_luke
#: scenarios/dark_force_rising/08_aboard_the_katana.cfg:179
msgid "Bridge secured. Slaving the fleet controls to this console now."
msgstr ""

#. [message]: speaker=sw_hero_han
#: scenarios/dark_force_rising/08_aboard_the_katana.cfg:183
msgid "Good, because the scopes just lit up. Two Star Destroyers, coming in fast. Guess who."
msgstr ""

#. [part]
#: scenarios/dark_force_rising/09_battle_for_the_fleet.cfg:30
msgid "With the Katana's bridge in New Republic hands, the slaved Dreadnaughts began to move. The Grand Admiral's Star Destroyers closed from above and below."
msgstr ""

#. [side]: id=sw_dfr09_chimaera, type=sw_unit_im_star_destroyer
#. [side]: id=sw_hte10_chimaera, type=sw_unit_im_star_destroyer
#. [side]: id=sw_tlc10_chimaera, type=sw_unit_im_star_destroyer
#: scenarios/dark_force_rising/09_battle_for_the_fleet.cfg:56
#: scenarios/dark_force_rising/09_battle_for_the_fleet.cfg:59
#: scenarios/heir_to_the_empire/10_thrawns_gambit.cfg:73
#: scenarios/heir_to_the_empire/10_thrawns_gambit.cfg:76
#: scenarios/the_last_command/10_the_last_command.cfg:58
#: scenarios/the_last_command/10_the_last_command.cfg:61
msgid "Chimaera"
msgstr ""

#. [side]: id=sw_dfr09_judicator, type=sw_unit_im_star_destroyer
#. [side]: id=sw_hte10_judicator, type=sw_unit_im_star_destroyer
#: scenarios/dark_force_rising/09_battle_for_the_fleet.cfg:81
#: scenarios/dark_force_rising/09_battle_for_the_fleet.cfg:84
#: scenarios/heir_to_the_empire/10_thrawns_gambit.cfg:98
#: scenarios/heir_to_the_empire/10_thrawns_gambit.cfg:101
msgid "Judicator"
msgstr ""

#. [event]
#: scenarios/dark_force_rising/09_battle_for_the_fleet.cfg:140
msgid "Katana"
msgstr ""

#. [event]
#: scenarios/dark_force_rising/09_battle_for_the_fleet.cfg:141
msgid "Valorous"
msgstr ""

#. [event]
#: scenarios/dark_force_rising/09_battle_for_the_fleet.cfg:142
msgid "Steadfast"
msgstr ""

#. [label]
#: scenarios/dark_force_rising/09_battle_for_the_fleet.cfg:154
msgid "Jump Point"
msgstr ""

#. [objective]: condition=win
#: scenarios/dark_force_rising/09_battle_for_the_fleet.cfg:159
msgid "Two Dreadnaughts reach the eastern edge and jump to safety"
msgstr ""

#. [objective]: condition=lose
#: scenarios/dark_force_rising/09_battle_for_the_fleet.cfg:163
msgid "Two Dreadnaughts destroyed"
msgstr ""

#. [event]
#: scenarios/dark_force_rising/09_battle_for_the_fleet.cfg:181
msgid "Commendable speed. But slaved ships are only as clever as the one ship that guides them. Target the Katana first, Captain."
msgstr ""

#. [message]: speaker=sw_hero_wedge
#: scenarios/dark_force_rising/09_battle_for_the_fleet.cfg:184
msgid "Every fighter on the Dreadnaughts. Bombers will go for the Katana. Don't let them through."
msgstr ""

#. [floating_text]
#: scenarios/dark_force_rising/09_battle_for_the_fleet.cfg:207
msgid "Jumped to lightspeed"
msgstr ""

#. [message]: speaker=sw_hero_wedge
#: scenarios/dark_force_rising/09_battle_for_the_fleet.cfg:241
msgid "We can't save enough of them. All fighters, break off!"
msgstr ""

#. [message]: speaker=sw_hero_luke
#: scenarios/dark_force_rising/09_battle_for_the_fleet.cfg:254
msgid "Two of them made the jump. It's not two hundred, Wedge, but he doesn't have them all."
msgstr ""

#. [event]
#: scenarios/dark_force_rising/09_battle_for_the_fleet.cfg:256
msgid "A small loss, Captain Pellaeon. We hold the rest of the fleet, and crews for every hull are already growing. Withdraw."
msgstr ""

#. [event]
#: scenarios/dark_force_rising/09_battle_for_the_fleet.cfg:310
msgid "They must reach the edge of the system to jump. Then we will be waiting at the edge."
msgstr ""

#. [message]: speaker=sw_hero_wedge
#: scenarios/dark_force_rising/09_battle_for_the_fleet.cfg:313
msgid "TIEs on the jump point. Somebody has to clear the way before the Dreadnaughts get there."
msgstr ""

#. [event]
#: scenarios/dark_force_rising/09_battle_for_the_fleet.cfg:336
msgid "Commander Antilles, Peregrine's fighters are at your disposal. I'd hate to see Thrawn get all two hundred."
msgstr ""

#. [message]: speaker=sw_hero_wedge
#: scenarios/dark_force_rising/09_battle_for_the_fleet.cfg:339
msgid "Glad to have you, General. Stay on the Dreadnaughts."
msgstr ""

#. [scenario]: id=sw_dfr_10_honoghrs_choice
#: scenarios/dark_force_rising/10_honoghrs_choice.cfg:11
msgid "Honoghr's Choice"
msgstr ""

#. [part]
#: scenarios/dark_force_rising/10_honoghrs_choice.cfg:24
msgid "Leia returned to Honoghr with a sample of the soil and a droid's maintenance records. The decontamination droids had never been cleaning the land. They had been keeping it poisoned, so that the Noghri would need the Empire forever."
msgstr ""

#. [part]
#: scenarios/dark_force_rising/10_honoghrs_choice.cfg:28
msgid "She stood in the clan house at Nystao and told them. Before the clans could answer, an Imperial shuttle landed to take her away."
msgstr ""

#. [side]: id=sw_hero_leia, type=sw_hero_leia
#: scenarios/dark_force_rising/10_honoghrs_choice.cfg:39
msgid "Leia and the Noghri"
msgstr ""

#. [side]: id=sw_dfr10_commander, type=sw_unit_im_officer
#: scenarios/dark_force_rising/10_honoghrs_choice.cfg:54
msgid "Imperial Detachment"
msgstr ""

#. [side]: id=sw_dfr10_commander, type=sw_unit_im_officer
#: scenarios/dark_force_rising/10_honoghrs_choice.cfg:57
msgid "Commander Sorrell"
msgstr ""

#. [side]
#: scenarios/dark_force_rising/10_honoghrs_choice.cfg:87
msgid "Noghri Clans"
msgstr ""

#. [objective]: condition=win
#: scenarios/dark_force_rising/10_honoghrs_choice.cfg:119
msgid "Hold out until the clans decide (end of the last turn)"
msgstr ""

#. [objective]: condition=win
#: scenarios/dark_force_rising/10_honoghrs_choice.cfg:123
msgid "Defeat Commander Sorrell"
msgstr ""

#. [note]
#: scenarios/dark_force_rising/10_honoghrs_choice.cfg:135
msgid "A second Imperial shuttle lands east of the village on turn 4. On turn 6 the Noghri clans give their answer and join your side."
msgstr ""

#. [message]: speaker=sw_hero_khabarakh
#: scenarios/dark_force_rising/10_honoghrs_choice.cfg:144
msgid "The clans are still debating, my lady. They will not move until they have decided. We must hold the dukha until then."
msgstr ""

#. [message]: speaker=sw_hero_leia
#: scenarios/dark_force_rising/10_honoghrs_choice.cfg:148
msgid "Then we hold it. Chewie, the west door."
msgstr ""

#. [message]: speaker=sw_hero_khabarakh
#: scenarios/dark_force_rising/10_honoghrs_choice.cfg:173
msgid "A second shuttle, east of the village!"
msgstr ""

#. [message]: speaker=narrator
#: scenarios/dark_force_rising/10_honoghrs_choice.cfg:203
msgid "The clans have spoken. We served the Empire for a generation because it told us we owed it our lives. It lied. The Lady Vader is under our protection."
msgstr ""

#. [message]: speaker=sw_hero_leia
#: scenarios/dark_force_rising/10_honoghrs_choice.cfg:207
msgid "Thank you. You don't owe me anything. But I'll be glad of the help."
msgstr ""

#. [message]: speaker=sw_hero_khabarakh
#: scenarios/dark_force_rising/10_honoghrs_choice.cfg:232
msgid "The Empire will learn of this. And every Noghri who guards the Grand Admiral will learn of it too."
msgstr ""

#. [message]: speaker=sw_hero_leia
#: scenarios/dark_force_rising/10_honoghrs_choice.cfg:236
msgid "Then he's about to discover what it's like to be watched by his own bodyguards."
msgstr ""

#. [event]
#: scenarios/dark_force_rising/10_honoghrs_choice.cfg:238
msgid "The Noghri have broken with us? ... Interesting. Then it is time to finish this war quickly, before they learn how much they know."
msgstr ""

#. [endlevel]
#: scenarios/dark_force_rising/10_honoghrs_choice.cfg:241
msgid ""
"The Noghri have learned the truth, and the Grand Admiral has lost the people who served him best, though he does not know it yet. His clones are still growing on a world called Wayland.\n"
"\n"
"The war ends in Campaign III: The Last Command."
msgstr ""

#. [part]
#: scenarios/heir_to_the_empire/01_ysalamiri_harvest.cfg:31
msgid "Five years after the Battle of Endor, the Empire is a shadow of itself. Its remaining fleets hold a quarter of the galaxy, and the New Republic expects them to collapse."
msgstr ""

#. [part]
#: scenarios/heir_to_the_empire/01_ysalamiri_harvest.cfg:35
msgid "But a Grand Admiral has returned from the Unknown Regions. He has studied the Rebellion's leaders the way he studies art, and he has begun to prepare."
msgstr ""

#. [part]
#: scenarios/heir_to_the_empire/01_ysalamiri_harvest.cfg:39
msgid "His first step leads to Myrkr, a forest world avoided by the Jedi of old and favored by smugglers. Something in its trees blinds the Force."
msgstr ""

#. [side]: id=sw_hero_pellaeon, type=sw_hero_pellaeon
#: scenarios/heir_to_the_empire/01_ysalamiri_harvest.cfg:57
msgid "Imperial Landing Party"
msgstr ""

#. [side]: id=sw_hero_pellaeon, type=sw_hero_pellaeon
#: scenarios/heir_to_the_empire/01_ysalamiri_harvest.cfg:60
msgid "Gilad Pellaeon"
msgstr ""

#. [side]
#: scenarios/heir_to_the_empire/01_ysalamiri_harvest.cfg:75
msgid "Vornskr Packs"
msgstr ""

#. [side]
#: scenarios/heir_to_the_empire/01_ysalamiri_harvest.cfg:90
msgid "Karrde's Smugglers"
msgstr ""

#. [unit]: id=sw_hte01_aves, type=sw_unit_sm_veteran
#: scenarios/heir_to_the_empire/01_ysalamiri_harvest.cfg:96
msgid "Aves"
msgstr ""

#. [label]
#: scenarios/heir_to_the_empire/01_ysalamiri_harvest.cfg:211
msgid "Lambda Shuttle"
msgstr ""

#. [label]
#: scenarios/heir_to_the_empire/01_ysalamiri_harvest.cfg:220
msgid "Smugglers' Camp"
msgstr ""

#. [objective]: condition=win
#: scenarios/heir_to_the_empire/01_ysalamiri_harvest.cfg:226
msgid "Harvest the four marked ysalamiri and bring each nutrient frame back to the shuttle (its landing pad or the landing apron around it)"
msgstr ""

#. [objective]: condition=lose
#: scenarios/heir_to_the_empire/01_ysalamiri_harvest.cfg:230
msgid "Death of Captain Pellaeon"
msgstr ""

#. [note]
#: scenarios/heir_to_the_empire/01_ysalamiri_harvest.cfg:235
msgid "Move a unit onto a marked tree to take its ysalamiri. A unit can carry only one frame. If the carrier falls, the frame returns to its tree."
msgstr ""

#. [note]
#: scenarios/heir_to_the_empire/01_ysalamiri_harvest.cfg:238
msgid "Karrde's smugglers are allowing the harvest. Leave them alone."
msgstr ""

#. [objectives]
#: scenarios/heir_to_the_empire/01_ysalamiri_harvest.cfg:240
#: scenarios/heir_to_the_empire/04_shadows_of_kashyyyk.cfg:171
msgid "Hold at least six settlements at the end"
msgstr ""

#. [event]
#: scenarios/heir_to_the_empire/01_ysalamiri_harvest.cfg:246
msgid "Captain, the creatures we need cling to the high branches. Four nutrient frames should be enough to start."
msgstr ""

#. [message]: speaker=sw_hero_pellaeon
#: scenarios/heir_to_the_empire/01_ysalamiri_harvest.cfg:249
msgid "Four lizards on four sticks, Admiral. I hope you will tell me what they are for."
msgstr ""

#. [event]
#: scenarios/heir_to_the_empire/01_ysalamiri_harvest.cfg:251
msgid "Each one pushes back the Force around itself, like a bubble in water. A Jedi standing inside one is an ordinary man. Mind the vornskrs; they hunt anything that touches the Force, and they are not particular about the rest."
msgstr ""

#. [message]: speaker=sw_hte01_aves
#: scenarios/heir_to_the_empire/01_ysalamiri_harvest.cfg:254
msgid "Karrde says take what you came for and go. Our people stay out of your way, and you stay out of ours."
msgstr ""

#. [message]: speaker=sw_hero_pellaeon
#: scenarios/heir_to_the_empire/01_ysalamiri_harvest.cfg:258
msgid "Understood. Squads, form up. Keep your eyes on the trees."
msgstr ""

#. [dummy]: id=sw_ability_ysalamiri
#: scenarios/heir_to_the_empire/01_ysalamiri_harvest.cfg:333
msgid "ysalamiri frame"
msgstr ""

#. [dummy]: id=sw_ability_ysalamiri
#: scenarios/heir_to_the_empire/01_ysalamiri_harvest.cfg:334
msgid "Carries a ysalamiri in its nutrient frame. The creature pushes the Force away from every hex within one of its bearer."
msgstr ""

#. [floating_text]
#: scenarios/heir_to_the_empire/01_ysalamiri_harvest.cfg:347
msgid "Frame secured"
msgstr ""

#. [floating_text]
#: scenarios/heir_to_the_empire/01_ysalamiri_harvest.cfg:396
msgid "Frame delivered"
msgstr ""

#. [message]: speaker=sw_hero_pellaeon
#: scenarios/heir_to_the_empire/01_ysalamiri_harvest.cfg:434
msgid "We lost a frame! The creature will have gone back to its branch. Send another squad."
msgstr ""

#. [message]: speaker=second_unit
#: scenarios/heir_to_the_empire/01_ysalamiri_harvest.cfg:467
msgid "Movement in the brush! Vornskrs!"
msgstr ""

#. [message]: speaker=sw_hero_pellaeon
#: scenarios/heir_to_the_empire/01_ysalamiri_harvest.cfg:475
msgid "All four frames are aboard, Admiral."
msgstr ""

#. [event]
#: scenarios/heir_to_the_empire/01_ysalamiri_harvest.cfg:477
msgid "Well done, Captain. Now we need a Jedi to test them on, and Intelligence tells me where one will be. Return to the Chimaera."
msgstr ""

#. [part]
#: scenarios/heir_to_the_empire/02_ambush_at_bpfassh.cfg:27
msgid "On Coruscant, the New Republic's leaders argue over trade quotas and old grievances. Leia Organa Solo, pregnant with twins, has come to Bpfassh to steady a nervous system government."
msgstr ""

#. [part]
#: scenarios/heir_to_the_empire/02_ambush_at_bpfassh.cfg:31
msgid "Han Solo and Chewbacca came with her. They did not expect the Empire to come too."
msgstr ""

#. [side]: id=sw_hte02_raid_commander, type=sw_unit_im_officer
#. [side]: id=sw_hte08_harbid, type=sw_unit_im_officer
#: scenarios/heir_to_the_empire/02_ambush_at_bpfassh.cfg:63
#: scenarios/heir_to_the_empire/08_nomad_city.cfg:70
msgid "Imperial Raiders"
msgstr ""

#. [side]: id=sw_hte02_raid_commander, type=sw_unit_im_officer
#: scenarios/heir_to_the_empire/02_ambush_at_bpfassh.cfg:66
msgid "Major Brendt"
msgstr ""

#. [side]
#: scenarios/heir_to_the_empire/02_ambush_at_bpfassh.cfg:107
msgid "Bpfassh Militia"
msgstr ""

#. [unit]: id=sw_hte02_militia_captain, type=sw_unit_nr_trooper
#: scenarios/heir_to_the_empire/02_ambush_at_bpfassh.cfg:113
msgid "Captain Tarvan"
msgstr ""

#. [label]
#: scenarios/heir_to_the_empire/02_ambush_at_bpfassh.cfg:166
msgid "Assembly Plaza"
msgstr ""

#. [objective]: condition=win
#: scenarios/heir_to_the_empire/02_ambush_at_bpfassh.cfg:171
msgid "Leia reaches the Millennium Falcon"
msgstr ""

#. [note]
#: scenarios/heir_to_the_empire/02_ambush_at_bpfassh.cfg:179
msgid "If Han or Chewbacca falls, that hero withdraws from the fight badly wounded and returns for the next mission."
msgstr ""

#. [note]
#: scenarios/heir_to_the_empire/02_ambush_at_bpfassh.cfg:185
msgid "Noghri commandos are invisible in the parks and at night until you move next to them."
msgstr ""

#. [objectives]
#: scenarios/heir_to_the_empire/02_ambush_at_bpfassh.cfg:187
msgid "Keep Han Solo and Chewbacca in the fight to the end"
msgstr ""

#. [message]: speaker=sw_hte02_militia_captain
#: scenarios/heir_to_the_empire/02_ambush_at_bpfassh.cfg:197
msgid "Your Highness, Imperial landing craft in the north district! It's a raid. They're hitting the warehouses and pulling out."
msgstr ""

#. [message]: speaker=sw_hero_han
#: scenarios/heir_to_the_empire/02_ambush_at_bpfassh.cfg:201
msgid "A raid this far inside our territory? I don't like it. Leia, we're going to the Falcon. Now."
msgstr ""

#. [message]: speaker=sw_hero_leia
#: scenarios/heir_to_the_empire/02_ambush_at_bpfassh.cfg:205
msgid "Not without making sure these people can hold. Captain, keep the plaza. We'll go through the east district."
msgstr ""

#. [message]: speaker=sw_hero_chewbacca
#: scenarios/heir_to_the_empire/02_ambush_at_bpfassh.cfg:209
msgid "<i>(Chewbacca growls and checks his bowcaster.)</i>"
msgstr ""

#. [message]: speaker=sw_hero_han
#: scenarios/heir_to_the_empire/02_ambush_at_bpfassh.cfg:221
msgid "Those aren't stormtroopers. Gray skin, no armor, no sound. Leia, stay behind Chewie!"
msgstr ""

#. [message]: speaker=sw_hero_leia
#: scenarios/heir_to_the_empire/02_ambush_at_bpfassh.cfg:225
msgid "They're not shooting to kill, Han. They want me alive."
msgstr ""

#. [message]: speaker=sw_hte02_militia_captain
#: scenarios/heir_to_the_empire/02_ambush_at_bpfassh.cfg:234
msgid "TIE fighters, coming in low over the plaza! Take cover!"
msgstr ""

#. [message]: speaker=sw_hte02_militia_captain
#: scenarios/heir_to_the_empire/02_ambush_at_bpfassh.cfg:275
msgid "More of our people are coming in from the south. We'll hold them, Your Highness!"
msgstr ""

#. [message]: speaker=sw_hero_han
#: scenarios/heir_to_the_empire/02_ambush_at_bpfassh.cfg:287
msgid "Chewie, get the engines warm! Everybody aboard!"
msgstr ""

#. [message]: speaker=sw_hero_leia
#: scenarios/heir_to_the_empire/02_ambush_at_bpfassh.cfg:291
msgid "Han, those commandos were after me, not the warehouses. Someone knew exactly where I would be."
msgstr ""

#. [message]: speaker=sw_hero_han
#: scenarios/heir_to_the_empire/02_ambush_at_bpfassh.cfg:295
msgid "Then we stop being where people expect. And we tell Luke. Wherever he's got to."
msgstr ""

#. [scenario]: id=sw_hte_03_adrift
#: scenarios/heir_to_the_empire/03_adrift.cfg:17
msgid "Adrift"
msgstr ""

#. [part]
#: scenarios/heir_to_the_empire/03_adrift.cfg:33
msgid "Far from Bpfassh, Luke Skywalker flies alone toward a meeting he was told the New Republic had arranged."
msgstr ""

#. [part]
#: scenarios/heir_to_the_empire/03_adrift.cfg:37
msgid "The message was false. A gravity-well trap pulls his X-wing out of hyperspace beside a drifting asteroid cluster, and a patrol of TIE fighters is already waiting."
msgstr ""

#. [side]
#: scenarios/heir_to_the_empire/03_adrift.cfg:71
msgid "Imperial Patrol"
msgstr ""

#. [regenerate]: id=sw_ability_astromech_repairs
#: scenarios/heir_to_the_empire/03_adrift.cfg:121
msgid "astromech repairs"
msgstr ""

#. [regenerate]: id=sw_ability_astromech_repairs
#: scenarios/heir_to_the_empire/03_adrift.cfg:122
msgid "Luke's astromech droid repairs 6 HP of damage at the start of each turn."
msgstr ""

#. [objective]: condition=win
#: scenarios/heir_to_the_empire/03_adrift.cfg:147
msgid "Survive until the end of the last turn"
msgstr ""

#. [objective]: condition=win
#: scenarios/heir_to_the_empire/03_adrift.cfg:151
msgid "Destroy every TIE fighter in the patrol"
msgstr ""

#. [note]
#: scenarios/heir_to_the_empire/03_adrift.cfg:165
msgid "Asteroid fields give your X-wing cover (60% defense) but cost 2 movement."
msgstr ""

#. [objectives]
#: scenarios/heir_to_the_empire/03_adrift.cfg:167
msgid "Destroy the whole patrol"
msgstr ""

#. [message]: speaker=sw_hero_luke
#: scenarios/heir_to_the_empire/03_adrift.cfg:199
msgid "More of them. They knew I was coming. Somebody set this up."
msgstr ""

#. [message]: speaker=sw_hero_luke
#: scenarios/heir_to_the_empire/03_adrift.cfg:224
msgid "Hyperdrive's out, and the motivator is smoking. Easy. Let's see what they've got."
msgstr ""

#. [message]: speaker=narrator
#: scenarios/heir_to_the_empire/03_adrift.cfg:228
msgid "Astromech"
msgstr ""

#. [message]: speaker=narrator
#: scenarios/heir_to_the_empire/03_adrift.cfg:229
msgid "<i>(Luke's astromech whistles a long, unhappy string of notes.)</i>"
msgstr ""

#. [message]: speaker=sw_hero_luke
#: scenarios/heir_to_the_empire/03_adrift.cfg:233
msgid "I know. Use the rocks for cover and keep the shields patched. Somebody will have heard the distress call."
msgstr ""

#. [message]: speaker=sw_hero_luke
#: scenarios/heir_to_the_empire/03_adrift.cfg:263
msgid "That's the last of them. Now I just have to wait."
msgstr ""

#. [message]: speaker=narrator
#: scenarios/heir_to_the_empire/03_adrift.cfg:284
#: scenarios/heir_to_the_empire/03_adrift.cfg:294
msgid "Wild Karrde"
msgstr ""

#. [message]: speaker=narrator
#: scenarios/heir_to_the_empire/03_adrift.cfg:285
msgid "Unidentified X-wing, this is the freighter Wild Karrde. Your drive signature is a mess and your friends are leaving. Stand by for tractor beam."
msgstr ""

#. [message]: speaker=sw_hero_luke
#: scenarios/heir_to_the_empire/03_adrift.cfg:289
msgid "Wild Karrde, I appreciate the help. Who am I talking to?"
msgstr ""

#. [message]: speaker=narrator
#: scenarios/heir_to_the_empire/03_adrift.cfg:295
msgid "Someone who's going to have a lot of questions for you, Skywalker. Power down your weapons."
msgstr ""

#. [scenario]: id=sw_hte_04_shadows_of_kashyyyk
#: scenarios/heir_to_the_empire/04_shadows_of_kashyyyk.cfg:15
msgid "Shadows of Kashyyyk"
msgstr ""

#. [part]
#: scenarios/heir_to_the_empire/04_shadows_of_kashyyyk.cfg:44
msgid "Han sent Leia and Chewbacca to the one place he trusted to hide her: Kashyyyk, where an entire world owes Chewbacca's friends a debt."
msgstr ""

#. [part]
#: scenarios/heir_to_the_empire/04_shadows_of_kashyyyk.cfg:48
msgid "High in the branches of the wroshyr trees, the Wookiees gave them shelter. The Noghri followed anyway."
msgstr ""

#. [side]
#: scenarios/heir_to_the_empire/04_shadows_of_kashyyyk.cfg:81
msgid "Noghri Commandos"
msgstr ""

#. [side]
#: scenarios/heir_to_the_empire/04_shadows_of_kashyyyk.cfg:102
msgid "Wookiees of Rwookrrorro"
msgstr ""

#. [unit]: id=sw_hte04_ralrra, type=sw_unit_wk_lookout
#: scenarios/heir_to_the_empire/04_shadows_of_kashyyyk.cfg:108
msgid "Ralrra"
msgstr ""

#. [objective]: condition=win
#: scenarios/heir_to_the_empire/04_shadows_of_kashyyyk.cfg:153
msgid "Survive until dawn"
msgstr ""

#. [objective]: condition=win
#: scenarios/heir_to_the_empire/04_shadows_of_kashyyyk.cfg:157
msgid "Defeat every Noghri commando"
msgstr ""

#. [note]
#: scenarios/heir_to_the_empire/04_shadows_of_kashyyyk.cfg:169
msgid "Noghri are invisible in forest and at night. A Wookiee Lookout reveals every Noghri within two hexes."
msgstr ""

#. [message]: speaker=sw_hte04_ralrra
#: scenarios/heir_to_the_empire/04_shadows_of_kashyyyk.cfg:179
msgid "<i>(Ralrra speaks in the Wookiee tongue; Chewbacca translates in growls and gestures.)</i> The trees are quiet tonight. Too quiet. My lookouts will watch the branches."
msgstr ""

#. [message]: speaker=sw_hero_leia
#: scenarios/heir_to_the_empire/04_shadows_of_kashyyyk.cfg:183
msgid "Thank you, Ralrra. If they come, they'll come for me. Keep your people back from the edges."
msgstr ""

#. [message]: speaker=sw_hero_chewbacca
#: scenarios/heir_to_the_empire/04_shadows_of_kashyyyk.cfg:187
msgid "<i>(Chewbacca rumbles a refusal and plants himself beside her.)</i>"
msgstr ""

#. [message]: speaker=sw_hte04_ralrra
#: scenarios/heir_to_the_empire/04_shadows_of_kashyyyk.cfg:225
msgid "More of them in the lower branches. They move like smoke."
msgstr ""

#. [message]: speaker=sw_hero_leia
#: scenarios/heir_to_the_empire/04_shadows_of_kashyyyk.cfg:249
msgid "There, in the branches. The same gray commandos from Bpfassh."
msgstr ""

#. [message]: speaker=sw_hero_leia
#: scenarios/heir_to_the_empire/04_shadows_of_kashyyyk.cfg:291
msgid "They're withdrawing. One of them looked at me before it went, almost as if it recognized me. I don't understand them."
msgstr ""

#. [message]: speaker=sw_hte04_ralrra
#: scenarios/heir_to_the_empire/04_shadows_of_kashyyyk.cfg:295
msgid "Whatever they are, they will not find you so easily in our trees again."
msgstr ""

#. [part]
#: scenarios/heir_to_the_empire/05_prisoner_of_myrkr.cfg:32
msgid "The Wild Karrde brought Luke to Myrkr. Talon Karrde was polite, curious, and unwilling to let him go: the Empire is offering a great deal of money for a Jedi."
msgstr ""

#. [part]
#: scenarios/heir_to_the_empire/05_prisoner_of_myrkr.cfg:36
msgid "Inside the compound, among the ysalamiri, Luke cannot feel the Force at all. He will have to escape the way anyone else would."
msgstr ""

#. [side]
#: scenarios/heir_to_the_empire/05_prisoner_of_myrkr.cfg:71
msgid "Karrde's Guards"
msgstr ""

#. [unit]: id=sw_hte05_drang, type=sw_unit_wl_vornskr
#: scenarios/heir_to_the_empire/05_prisoner_of_myrkr.cfg:94
msgid "Drang"
msgstr ""

#. [effect]: type=impact
#. [attack]: type=impact
#: scenarios/heir_to_the_empire/05_prisoner_of_myrkr.cfg:135
#: units/dfr_units.cfg:996
#: units/dfr_units.cfg:1209
#: units/dfr_units.cfg:1423
#: units/hte_heroes.cfg:1836
#: units/hte_heroes.cfg:2081
#: units/hte_heroes.cfg:2327
#: units/hte_heroes.cfg:2533
#: units/hte_heroes.cfg:2789
#: units/hte_heroes.cfg:3046
#: units/hte_heroes.cfg:4086
#: units/hte_heroes.cfg:4339
#: units/hte_heroes.cfg:4593
#: units/hte_heroes.cfg:5519
#: units/hte_heroes.cfg:5735
#: units/hte_heroes.cfg:5952
#: units/hte_heroes.cfg:7046
#: units/hte_heroes.cfg:7254
#: units/hte_imperial.cfg:896
#: units/hte_new_republic.cfg:2133
#: units/hte_new_republic.cfg:2380
#: units/hte_new_republic.cfg:3123
msgid "fists"
msgstr ""

#. [label]
#: scenarios/heir_to_the_empire/05_prisoner_of_myrkr.cfg:177
msgid "Karrde's Office"
msgstr ""

#. [label]
#: scenarios/heir_to_the_empire/05_prisoner_of_myrkr.cfg:185
msgid "Vehicle Shed"
msgstr ""

#. [objective]: condition=win
#: scenarios/heir_to_the_empire/05_prisoner_of_myrkr.cfg:196
msgid "Recover your lightsaber from Karrde's office"
msgstr ""

#. [objective]: condition=win
#: scenarios/heir_to_the_empire/05_prisoner_of_myrkr.cfg:208
msgid "Reach the vehicle shed with your lightsaber"
msgstr ""

#. [note]
#: scenarios/heir_to_the_empire/05_prisoner_of_myrkr.cfg:217
msgid "The whole compound is inside a ysalamiri bubble: Luke's Force abilities and deflection do not work."
msgstr ""

#. [note]
#: scenarios/heir_to_the_empire/05_prisoner_of_myrkr.cfg:220
msgid "Karrde's guards have not noticed you yet. They see only the way they face, 3 hexes, one less at night and one less again when you are in cover (forest, crates, buildings); walls block their view. Amber hexes show where they can see. If one spots you, it shouts and every guard nearby joins the hunt."
msgstr ""

#. [note]
#: scenarios/heir_to_the_empire/05_prisoner_of_myrkr.cfg:223
msgid "Sneak up behind an unaware guard and right-click Luke for a <b>Silent takedown</b> (uses your attack), in the same turn: at the start of their turn guards on post turn about and notice anyone beside them. Any other guard who can see that spot will raise the alarm. Drang the vornskr senses all round and cannot be surprised."
msgstr ""

#. [objectives]
#: scenarios/heir_to_the_empire/05_prisoner_of_myrkr.cfg:225
msgid "Never raise the alarm"
msgstr ""

#. [message]: speaker=sw_hero_luke
#: scenarios/heir_to_the_empire/05_prisoner_of_myrkr.cfg:233
msgid "Nothing. It's like going deaf. Karrde's lizards are everywhere in this place."
msgstr ""

#. [message]: speaker=sw_hero_luke
#: scenarios/heir_to_the_empire/05_prisoner_of_myrkr.cfg:237
msgid "All right. One guard at the door. My lightsaber will be in Karrde's office. I'm not leaving without it."
msgstr ""

#. [effect]: type=fire
#. [attack]: type=fire
#: scenarios/heir_to_the_empire/05_prisoner_of_myrkr.cfg:264
#: units/hte_heroes.cfg:4868
#: units/hte_heroes.cfg:5091
#: units/hte_heroes.cfg:5315
#: units/hte_smugglers.cfg:817
#: units/tlc_units.cfg:1094
msgid "hold-out blaster"
msgstr ""

#. [message]: speaker=sw_hero_luke
#: scenarios/heir_to_the_empire/05_prisoner_of_myrkr.cfg:274
msgid "Somebody's spare hold-out blaster. Careless of them."
msgstr ""

#. [message]: speaker=sw_hero_luke
#: scenarios/heir_to_the_empire/05_prisoner_of_myrkr.cfg:322
msgid "There you are."
msgstr ""

#. [message]: speaker=sw_hte05_mara
#: scenarios/heir_to_the_empire/05_prisoner_of_myrkr.cfg:362
msgid "Skywalker's loose! He's in the main house. I'm coming in from the trees. Nobody shoots him except me."
msgstr ""

#. [message]: speaker=sw_hero_luke
#: scenarios/heir_to_the_empire/05_prisoner_of_myrkr.cfg:366
msgid "She means that. Time to find a vehicle."
msgstr ""

#. [message]: speaker=sw_hero_luke
#: scenarios/heir_to_the_empire/05_prisoner_of_myrkr.cfg:387
msgid "A skiff. Fueled, too. Let's see how far it gets me."
msgstr ""

#. [message]: speaker=narrator
#: scenarios/heir_to_the_empire/05_prisoner_of_myrkr.cfg:397
msgid "Not far, Skywalker. I'm right behind you."
msgstr ""

#. [message]: speaker=sw_hero_luke
#: scenarios/heir_to_the_empire/05_prisoner_of_myrkr.cfg:408
msgid "Not without my lightsaber."
msgstr ""

#. [part]
#: scenarios/heir_to_the_empire/06_raid_on_karrdes_base.cfg:44
msgid "Han Solo and Lando Calrissian came to Myrkr following a rumor: Talon Karrde knew where Luke Skywalker was."
msgstr ""

#. [part]
#: scenarios/heir_to_the_empire/06_raid_on_karrdes_base.cfg:48
msgid "Karrde received them warmly and told them nothing. That night Luke escaped, and by morning an Imperial assault force was landing outside the walls, looking for him."
msgstr ""

#. [side]: id=sw_hero_han, type=sw_hero_han
#: scenarios/heir_to_the_empire/06_raid_on_karrdes_base.cfg:65
msgid "New Republic and Karrde's People"
msgstr ""

#. [side]: id=sw_hte06_vosk, type=sw_unit_im_officer
#: scenarios/heir_to_the_empire/06_raid_on_karrdes_base.cfg:80
msgid "Imperial Assault Force"
msgstr ""

#. [side]: id=sw_hte06_vosk, type=sw_unit_im_officer
#: scenarios/heir_to_the_empire/06_raid_on_karrdes_base.cfg:83
msgid "Captain Vosk"
msgstr ""

#. [event]
#. [side]: id=sw_hero_karrde, type=sw_hero_karrde
#: scenarios/heir_to_the_empire/06_raid_on_karrdes_base.cfg:135
#: scenarios/the_last_command/02_the_smugglers_council.cfg:45
#: scenarios/the_last_command/10_the_last_command.cfg:275
msgid "Talon Karrde"
msgstr ""

#. [label]
#: scenarios/heir_to_the_empire/06_raid_on_karrdes_base.cfg:182
msgid "Transport"
msgstr ""

#. [objective]: condition=win
#: scenarios/heir_to_the_empire/06_raid_on_karrdes_base.cfg:190
msgid "Get Karrde's people to the transports on the landing field"
msgstr ""

#. [objective]: condition=win
#: scenarios/heir_to_the_empire/06_raid_on_karrdes_base.cfg:194
msgid "Then bring Han to the transports (with Lando, if he is still in the fight)"
msgstr ""

#. [note]
#: scenarios/heir_to_the_empire/06_raid_on_karrdes_base.cfg:202
msgid "If Karrde falls, he withdraws from the fight badly wounded. If Lando falls, he withdraws too and returns for the next mission."
msgstr ""

#. [note]
#: scenarios/heir_to_the_empire/06_raid_on_karrdes_base.cfg:208
msgid "Karrde and his smugglers leave the battle when they reach a transport. Karrde counts as an evacuee."
msgstr ""

#. [note]
#: scenarios/heir_to_the_empire/06_raid_on_karrdes_base.cfg:211
msgid "The transports' engines are cold: they cannot launch before turn"
msgstr ""

#. [note]
#: scenarios/heir_to_the_empire/06_raid_on_karrdes_base.cfg:211
msgid "Anyone already aboard leaves as soon as they are ready."
msgstr ""

#. [message]: speaker=sw_hero_karrde
#: scenarios/heir_to_the_empire/06_raid_on_karrdes_base.cfg:224
msgid "An Imperial assault force, at my front gate. Someone has been very indiscreet about my guest."
msgstr ""

#. [message]: speaker=sw_hero_han
#: scenarios/heir_to_the_empire/06_raid_on_karrdes_base.cfg:228
msgid "Guest? You had Luke here?"
msgstr ""

#. [message]: speaker=sw_hero_karrde
#: scenarios/heir_to_the_empire/06_raid_on_karrdes_base.cfg:232
msgid "Had, Captain Solo. He left last night, with my second-in-command close behind him. We can argue about it later. My people need to reach the transports."
msgstr ""

#. [message]: speaker=sw_hero_lando
#: scenarios/heir_to_the_empire/06_raid_on_karrdes_base.cfg:236
msgid "Then let's give them a reason to keep their heads down. Han, you take the house; I'll take the yard."
msgstr ""

#. [floating_text]
#: scenarios/heir_to_the_empire/06_raid_on_karrdes_base.cfg:268
msgid "Engines warming up"
msgstr ""

#. [floating_text]
#: scenarios/heir_to_the_empire/06_raid_on_karrdes_base.cfg:283
msgid "Evacuated"
msgstr ""

#. [message]: speaker=sw_hero_han
#: scenarios/heir_to_the_empire/06_raid_on_karrdes_base.cfg:298
msgid "That's enough of them aboard. Lando, time to go!"
msgstr ""

#. [message]: speaker=sw_hero_karrde
#: scenarios/heir_to_the_empire/06_raid_on_karrdes_base.cfg:329
msgid "The transports' engines are hot. Everyone at the landing field, get aboard!"
msgstr ""

#. [message]: speaker=sw_hero_karrde
#: scenarios/heir_to_the_empire/06_raid_on_karrdes_base.cfg:384
msgid "Movement in the trees east of the landing field. They've circled round to cut us off from the transports."
msgstr ""

#. [message]: speaker=sw_hero_lando
#: scenarios/heir_to_the_empire/06_raid_on_karrdes_base.cfg:388
msgid "Then we hold that field until the engines are warm. Nobody boards a ship that can't fly."
msgstr ""

#. [message]: speaker=sw_hero_lando
#: scenarios/heir_to_the_empire/06_raid_on_karrdes_base.cfg:452
msgid "Karrde says the Imperials have speeder bikes out in the forest. They're still hunting Luke."
msgstr ""

#. [message]: speaker=sw_hero_han
#: scenarios/heir_to_the_empire/06_raid_on_karrdes_base.cfg:456
msgid "Then Luke's alive and they haven't caught him. That's the best news I've had all week. Punch it."
msgstr ""

#. [part]
#: scenarios/heir_to_the_empire/07_the_forest_crossing.cfg:31
msgid "Luke's stolen skiff made it a few kilometers before Mara Jade's shots brought it down. Her own craft followed it into the trees."
msgstr ""

#. [part]
#: scenarios/heir_to_the_empire/07_the_forest_crossing.cfg:35
msgid "Now the two of them are alone in the Myrkr forest with Imperial speeder bikes overhead. Hyllyard City is days away on foot. Mara has made it clear she would rather kill Luke than help him, but neither of them will get there alone."
msgstr ""

#. [side]: id=sw_hero_luke, type=sw_hero_luke
#: scenarios/heir_to_the_empire/07_the_forest_crossing.cfg:52
#: scenarios/the_last_command/04_landfall_on_wayland.cfg:44
#: scenarios/the_last_command/05_the_natives_of_wayland.cfg:39
#: scenarios/the_last_command/08_the_throne_room.cfg:41
msgid "Luke and Mara"
msgstr ""

#. [side]
#: scenarios/heir_to_the_empire/07_the_forest_crossing.cfg:69
msgid "Imperial Hunters"
msgstr ""

#. [unit]: id=sw_hte07_officer, type=sw_unit_im_officer
#: scenarios/heir_to_the_empire/07_the_forest_crossing.cfg:101
msgid "Lieutenant Krell"
msgstr ""

#. [side]
#: scenarios/heir_to_the_empire/07_the_forest_crossing.cfg:115
msgid "Vornskrs"
msgstr ""

#. [label]
#: scenarios/heir_to_the_empire/07_the_forest_crossing.cfg:161
msgid "Hyllyard City"
msgstr ""

#. [label]
#: scenarios/heir_to_the_empire/07_the_forest_crossing.cfg:170
msgid "City Gate"
msgstr ""

#. [label]
#: scenarios/heir_to_the_empire/07_the_forest_crossing.cfg:179
msgid "Hunter's Cabin"
msgstr ""

#. [objective]: condition=win
#: scenarios/heir_to_the_empire/07_the_forest_crossing.cfg:184
msgid "Luke reaches Hyllyard City through its west gate (with Mara, if she is still in the fight)"
msgstr ""

#. [note]
#: scenarios/heir_to_the_empire/07_the_forest_crossing.cfg:192
msgid "If Mara falls, she withdraws from the fight badly wounded and slips away into the forest."
msgstr ""

#. [note]
#: scenarios/heir_to_the_empire/07_the_forest_crossing.cfg:197
msgid "Violet hexes are ysalamiri bubbles: Luke's Force abilities and deflection fail inside them. Vornskrs hunt Force-sensitives and hit Luke harder."
msgstr ""

#. [note]
#: scenarios/heir_to_the_empire/07_the_forest_crossing.cfg:200
msgid "Speeder bikes are fast in clearings and slow among the trees."
msgstr ""

#. [objectives]
#: scenarios/heir_to_the_empire/07_the_forest_crossing.cfg:202
#: scenarios/the_last_command/02_the_smugglers_council.cfg:150
#: scenarios/the_last_command/04_landfall_on_wayland.cfg:131
#: scenarios/the_last_command/08_the_throne_room.cfg:142
msgid "Keep Mara Jade in the fight to the end"
msgstr ""

#. [message]: speaker=sw_hero_mara
#: scenarios/heir_to_the_empire/07_the_forest_crossing.cfg:210
msgid "Don't get comfortable, Skywalker. The moment we're out of this forest, we settle things."
msgstr ""

#. [message]: speaker=sw_hero_luke
#: scenarios/heir_to_the_empire/07_the_forest_crossing.cfg:214
msgid "You keep saying that. You still haven't said why."
msgstr ""

#. [message]: speaker=sw_hero_mara
#: scenarios/heir_to_the_empire/07_the_forest_crossing.cfg:218
msgid "I have my reasons. Right now, I have Imperial scouts on bikes and a forest full of vornskrs. Walk."
msgstr ""

#. [message]: speaker=sw_hero_mara
#: scenarios/heir_to_the_empire/07_the_forest_crossing.cfg:231
msgid "Karrde keeps a comm relay here. I can call two of our people who are still in the forest. They'll help us. Not you. Us."
msgstr ""

#. [message]: speaker=sw_hero_luke
#: scenarios/heir_to_the_empire/07_the_forest_crossing.cfg:272
msgid "More bikes, coming in from the north."
msgstr ""

#. [message]: speaker=sw_hero_mara
#: scenarios/heir_to_the_empire/07_the_forest_crossing.cfg:305
msgid "They go for you because they can feel the Force in you. Karrde's tame ones do the same thing. Keep moving."
msgstr ""

#. [message]: speaker=sw_hero_luke
#: scenarios/heir_to_the_empire/07_the_forest_crossing.cfg:344
msgid "Hyllyard City. We made it. So, do we settle things now?"
msgstr ""

#. [message]: speaker=sw_hero_mara
#: scenarios/heir_to_the_empire/07_the_forest_crossing.cfg:348
msgid "Not today. Karrde will want to hear about this first. Next time, Skywalker."
msgstr ""

#. [side]: id=sw_hero_lando, type=sw_hero_lando
#. [scenario]: id=sw_hte_08_nomad_city
#: scenarios/heir_to_the_empire/08_nomad_city.cfg:55
#: scenarios/heir_to_the_empire/08_nomad_city.cfg:19
msgid "Nomad City"
msgstr ""

#. [part]
#: scenarios/heir_to_the_empire/08_nomad_city.cfg:34
msgid "On Nkllon, so close to its sun that the dayside would melt an unshielded ship, Lando Calrissian's Nomad City crawls across the surface, staying always in the planet's shadow and mining the rock as it goes."
msgstr ""

#. [part]
#: scenarios/heir_to_the_empire/08_nomad_city.cfg:38
msgid "Han brought word of Luke and the smugglers. While they talked, Imperial raiders landed on the sunside. They were not after the metals. They wanted Lando's mole miners."
msgstr ""

#. [side]: id=sw_hte08_harbid, type=sw_unit_im_officer
#: scenarios/heir_to_the_empire/08_nomad_city.cfg:73
msgid "Captain Harbid"
msgstr ""

#. [label]
#: scenarios/heir_to_the_empire/08_nomad_city.cfg:147
msgid "Mole Miner Shed"
msgstr ""

#. [label]
#: scenarios/heir_to_the_empire/08_nomad_city.cfg:161
msgid "Extraction"
msgstr ""

#. [objective]: condition=win
#: scenarios/heir_to_the_empire/08_nomad_city.cfg:166
msgid "Defeat Captain Harbid"
msgstr ""

#. [objective]: condition=win
#: scenarios/heir_to_the_empire/08_nomad_city.cfg:170
msgid "Hold out until the end of the last turn"
msgstr ""

#. [objective]: condition=lose
#: scenarios/heir_to_the_empire/08_nomad_city.cfg:174
msgid "Hijacked mole miners reach the extraction zone in the west"
msgstr ""

#. [objective]: condition=lose
#: scenarios/heir_to_the_empire/08_nomad_city.cfg:178
msgid "Death of Lando"
msgstr ""

#. [note]
#: scenarios/heir_to_the_empire/08_nomad_city.cfg:182
msgid "If Han falls, he withdraws from the fight badly wounded and returns for the next mission."
msgstr ""

#. [note]
#: scenarios/heir_to_the_empire/08_nomad_city.cfg:187
msgid "Nkllon's sun: any unit ending its turn on open sand or dunes takes 4 damage. Rock outcrops and the city are shaded."
msgstr ""

#. [note]
#: scenarios/heir_to_the_empire/08_nomad_city.cfg:190
msgid "A raider who reaches a shed steals its mole miner. Hijacked miners head straight for the western edge."
msgstr ""

#. [message]: speaker=sw_hero_lando
#: scenarios/heir_to_the_empire/08_nomad_city.cfg:202
msgid "Raiders on the sunside, heading for the miner sheds. Somebody wants mole miners badly enough to cook their own troops getting here."
msgstr ""

#. [message]: speaker=sw_hero_han
#: scenarios/heir_to_the_empire/08_nomad_city.cfg:206
msgid "Mole miners? What does the Empire want with mining equipment?"
msgstr ""

#. [message]: speaker=sw_hero_lando
#: scenarios/heir_to_the_empire/08_nomad_city.cfg:210
msgid "I don't know, and I don't like not knowing. Keep them off the sheds, and don't stand around in the sun."
msgstr ""

#. [message]: speaker=sw_hero_lando
#: scenarios/heir_to_the_empire/08_nomad_city.cfg:276
msgid "They've got a mole miner out of the shed! Stop it before it reaches their landing zone!"
msgstr ""

#. [floating_text]
#: scenarios/heir_to_the_empire/08_nomad_city.cfg:303
msgid "Mole miner stolen"
msgstr ""

#. [message]: speaker=sw_hero_lando
#: scenarios/heir_to_the_empire/08_nomad_city.cfg:313
msgid "That's too many. Whatever they're planning, we just handed them the tools."
msgstr ""

#. [message]: speaker=unit
#: scenarios/heir_to_the_empire/08_nomad_city.cfg:329
msgid "Withdraw! Take what we have and withdraw!"
msgstr ""

#. [message]: speaker=sw_hero_han
#: scenarios/heir_to_the_empire/08_nomad_city.cfg:347
msgid "They're pulling out. Lando, how many miners did they get?"
msgstr ""

#. [message]: speaker=sw_hero_lando
#: scenarios/heir_to_the_empire/08_nomad_city.cfg:351
msgid "$sw_hte08_stolen| of them. And the shipyards at Sluis Van just sent a call for every pilot and miner crew we can spare: a whole relief fleet is docking there for refit."
msgstr ""

#. [message]: speaker=sw_hero_han
#: scenarios/heir_to_the_empire/08_nomad_city.cfg:355
msgid "Mole miners and a shipyard full of warships with skeleton crews. I think I know what they want them for."
msgstr ""

#. [part]
#: scenarios/heir_to_the_empire/09_sluis_van_shipyards.cfg:33
msgid "The Sluis Van shipyards are crowded with warships of a relief fleet, docked for refit with skeleton crews. Han's warning reached Rogue Squadron's commander, Wedge Antilles, only hours before the sensors lit up."
msgstr ""

#. [part]
#: scenarios/heir_to_the_empire/09_sluis_van_shipyards.cfg:37
msgid "Luke Skywalker, back from Myrkr, took his X-wing out with them."
msgstr ""

#. [side]: id=sw_hero_wedge, type=sw_hero_wedge
#: scenarios/heir_to_the_empire/09_sluis_van_shipyards.cfg:54
#: scenarios/heir_to_the_empire/10_thrawns_gambit.cfg:58
msgid "Sluis Van Defense"
msgstr ""

#. [side]
#: scenarios/heir_to_the_empire/09_sluis_van_shipyards.cfg:70
msgid "Imperial Strike Group"
msgstr ""

#. [event]
#: scenarios/heir_to_the_empire/09_sluis_van_shipyards.cfg:118
msgid "Corsair's Pride"
msgstr ""

#. [event]
#: scenarios/heir_to_the_empire/09_sluis_van_shipyards.cfg:119
#: scenarios/heir_to_the_empire/10_thrawns_gambit.cfg:145
msgid "Liberty's Hope"
msgstr ""

#. [event]
#: scenarios/heir_to_the_empire/09_sluis_van_shipyards.cfg:120
msgid "Kestrel"
msgstr ""

#. [event]
#: scenarios/heir_to_the_empire/09_sluis_van_shipyards.cfg:121
#: scenarios/heir_to_the_empire/10_thrawns_gambit.cfg:146
msgid "Valiant"
msgstr ""

#. [objective]: condition=win
#: scenarios/heir_to_the_empire/09_sluis_van_shipyards.cfg:138
msgid "Destroy every hijacked mole miner"
msgstr ""

#. [objective]: condition=lose
#: scenarios/heir_to_the_empire/09_sluis_van_shipyards.cfg:142
msgid "Two docked warships captured"
msgstr ""

#. [note]
#: scenarios/heir_to_the_empire/09_sluis_van_shipyards.cfg:155
msgid "Mole miners must reach a warship and cut into it at close range. Warships cannot fire back at them."
msgstr ""

#. [message]: speaker=sw_hero_wedge
#: scenarios/heir_to_the_empire/09_sluis_van_shipyards.cfg:190
msgid "Rogue Squadron, we have TIEs and something else on the scopes. Big, slow, and heading straight for the docks."
msgstr ""

#. [message]: speaker=sw_hero_luke
#: scenarios/heir_to_the_empire/09_sluis_van_shipyards.cfg:194
msgid "Mole miners. Han was right. They're going to cut into the warships and fly them out with boarding crews."
msgstr ""

#. [message]: speaker=sw_hero_wedge
#: scenarios/heir_to_the_empire/09_sluis_van_shipyards.cfg:198
msgid "Not today. Fighters, screen the docks. Bombers, go for the miners."
msgstr ""

#. [message]: speaker=sw_hero_wedge
#: scenarios/heir_to_the_empire/09_sluis_van_shipyards.cfg:233
msgid "Last group coming in. Take out those miners and this is over."
msgstr ""

#. [message]: speaker=sw_hero_wedge
#: scenarios/heir_to_the_empire/09_sluis_van_shipyards.cfg:261
msgid "That's the last mole miner. The docks are secure."
msgstr ""

#. [message]: speaker=sw_hero_luke
#: scenarios/heir_to_the_empire/09_sluis_van_shipyards.cfg:265
msgid "The docks, yes. But the Star Destroyers are still out there, and they haven't committed yet."
msgstr ""

#. [message]: speaker=sw_hero_wedge
#: scenarios/heir_to_the_empire/09_sluis_van_shipyards.cfg:289
msgid "They've cut into the $unit.name|! Boarding crews are aboard. We've lost her."
msgstr ""

#. [scenario]: id=sw_hte_10_thrawns_gambit
#: scenarios/heir_to_the_empire/10_thrawns_gambit.cfg:17
msgid "Thrawn's Gambit"
msgstr ""

#. [event]: id=sw_doctrine_grant_start
#: scenarios/heir_to_the_empire/10_thrawns_gambit.cfg:28
msgid "Recordings of New Republic victory celebrations, studied aboard the Chimaera, show how its commanders like to win."
msgstr ""

#. [part]
#: scenarios/heir_to_the_empire/10_thrawns_gambit.cfg:37
msgid "The mole miners failed. On the bridge of the Chimaera, Grand Admiral Thrawn watched the last of them break apart and did not seem disappointed."
msgstr ""

#. [part]
#: scenarios/heir_to_the_empire/10_thrawns_gambit.cfg:41
msgid "Then two Star Destroyers came forward out of the system's edge, launching fighters as they came. If the Empire could not steal the shipyard's warships, it would destroy them where they lay."
msgstr ""

#. [objective]: condition=win
#: scenarios/heir_to_the_empire/10_thrawns_gambit.cfg:168
msgid "Destroy the Judicator"
msgstr ""

#. [objective]: condition=win
#: scenarios/heir_to_the_empire/10_thrawns_gambit.cfg:172
msgid "Damage the Chimaera to half strength"
msgstr ""

#. [objective]: condition=win
#: scenarios/heir_to_the_empire/10_thrawns_gambit.cfg:176
msgid "Hold until the last turn with at least one warship intact"
msgstr ""

#. [objective]: condition=lose
#: scenarios/heir_to_the_empire/10_thrawns_gambit.cfg:180
msgid "Both warships destroyed"
msgstr ""

#. [note]
#: scenarios/heir_to_the_empire/10_thrawns_gambit.cfg:191
msgid "Star Destroyers are slow and heavily shielded but cannot dodge. Y-wing ion cannons slow them; proton torpedoes hit hard."
msgstr ""

#. [event]
#: scenarios/heir_to_the_empire/10_thrawns_gambit.cfg:198
msgid "Captain Pellaeon, launch all fighters. Their pilots are tired and their warships cannot move. Make them choose what to protect."
msgstr ""

#. [message]: speaker=sw_hero_wedge
#: scenarios/heir_to_the_empire/10_thrawns_gambit.cfg:201
msgid "Two Star Destroyers. All right, Rogues, the warships can't run, so neither can we."
msgstr ""

#. [message]: speaker=sw_hero_luke
#: scenarios/heir_to_the_empire/10_thrawns_gambit.cfg:205
msgid "Wedge, the second ship is holding back, covering the first. If we hurt one of them badly enough, I don't think he'll risk both."
msgstr ""

#. [message]: speaker=narrator
#: scenarios/heir_to_the_empire/10_thrawns_gambit.cfg:282
#: scenarios/the_last_command/10_the_last_command.cfg:201
msgid "Captain Pellaeon"
msgstr ""

#. [message]: speaker=narrator
#: scenarios/heir_to_the_empire/10_thrawns_gambit.cfg:283
msgid "Admiral, we've lost the initiative here. Shall I commit the reserve?"
msgstr ""

#. [event]
#: scenarios/heir_to_the_empire/10_thrawns_gambit.cfg:285
msgid "No, Captain. Withdraw. We have learned a great deal today about how the New Republic defends what it values. And the mole miners were only ever one way to get warships."
msgstr ""

#. [event]
#: scenarios/heir_to_the_empire/10_thrawns_gambit.cfg:286
msgid "Somewhere out there is a fleet of two hundred Dreadnaughts, lost before the Clone Wars ended. Find me the man who knows where it is."
msgstr ""

#. [message]: speaker=sw_hero_wedge
#: scenarios/heir_to_the_empire/10_thrawns_gambit.cfg:289
msgid "They're jumping out. Both of them. We held Sluis Van."
msgstr ""

#. [message]: speaker=sw_hero_luke
#: scenarios/heir_to_the_empire/10_thrawns_gambit.cfg:293
msgid "We held it because he let us. He was testing us, Wedge. This isn't over. I don't think it has even started."
msgstr ""

#. [endlevel]
#: scenarios/heir_to_the_empire/10_thrawns_gambit.cfg:297
msgid ""
"The Sluis Van shipyards are saved, but the Grand Admiral has learned what he came to learn. Somewhere in the dark, two hundred lost warships are waiting.\n"
"\n"
"The war continues in Campaign II: Dark Force Rising."
msgstr ""

#. [event]
#: scenarios/heir_to_the_empire/10_thrawns_gambit.cfg:410
msgid "Now, Captain. Send the reserve squadron to the warship they are not watching."
msgstr ""

#. [message]: speaker=sw_hero_wedge
#: scenarios/heir_to_the_empire/10_thrawns_gambit.cfg:420
msgid "Bombers dropping out of the shipyard traffic, right on top of Liberty's Hope! Somebody get over there!"
msgstr ""

#. [message]: speaker=sw_hero_wedge
#: scenarios/heir_to_the_empire/10_thrawns_gambit.cfg:427
msgid "Bombers coming in under the Valiant! He waited until we'd committed. Somebody get down there!"
msgstr ""

#. [unit]: id=sw_hte10_picket_lead, type=sw_unit_nr_xwing
#: scenarios/heir_to_the_empire/10_thrawns_gambit.cfg:451
msgid "Captain Tal Dunn"
msgstr ""

#. [message]: speaker=sw_hte10_picket_lead
#: scenarios/heir_to_the_empire/10_thrawns_gambit.cfg:463
msgid "Sluis Van picket, rearmed and ready. Sorry we're late, Commander. Where do you want us?"
msgstr ""

#. [message]: speaker=sw_hero_wedge
#: scenarios/heir_to_the_empire/10_thrawns_gambit.cfg:467
msgid "Anywhere there's a TIE. Welcome to the party."
msgstr ""

#. [event]: id=sw_doctrine_grant_start
#: scenarios/the_last_command/01_the_siege_of_coruscant.cfg:24
msgid "Delta Source reports from inside the Imperial Palace describe the defence plans for Coruscant."
msgstr ""

#. [part]
#: scenarios/the_last_command/01_the_siege_of_coruscant.cfg:33
msgid "The Grand Admiral did not attack Coruscant. He did something worse. His ships slipped into orbit, released something, and left."
msgstr ""

#. [part]
#: scenarios/the_last_command/01_the_siege_of_coruscant.cfg:37
msgid "Sensors could find nothing. Then a freighter broke apart on an invisible rock, and the New Republic understood: the capital was surrounded by cloaked asteroids, and no one knew how many."
msgstr ""

#. [side]: id=sw_hero_wedge, type=sw_hero_wedge
#: scenarios/the_last_command/01_the_siege_of_coruscant.cfg:48
msgid "Coruscant Defense"
msgstr ""

#. [side]
#: scenarios/the_last_command/01_the_siege_of_coruscant.cfg:64
msgid "Imperial Minelaying Group"
msgstr ""

#. [unit]: id=sw_tlc01_minelayer_n, type=sw_unit_im_minelayer
#: scenarios/the_last_command/01_the_siege_of_coruscant.cfg:73
msgid "Minelayer Aurek"
msgstr ""

#. [unit]: id=sw_tlc01_minelayer_s, type=sw_unit_im_minelayer
#: scenarios/the_last_command/01_the_siege_of_coruscant.cfg:80
msgid "Minelayer Besh"
msgstr ""

#. [side]
#: scenarios/the_last_command/01_the_siege_of_coruscant.cfg:105
#: scenarios/the_last_command/09_bilbringi.cfg:86
msgid "Cloaked Asteroids"
msgstr ""

#. [objective]: condition=win
#: scenarios/the_last_command/01_the_siege_of_coruscant.cfg:144
msgid "Destroy both Imperial minelayers"
msgstr ""

#. [note]
#: scenarios/the_last_command/01_the_siege_of_coruscant.cfg:156
msgid "Cloaked asteroids are invisible. A ship that ends its turn next to one takes 8 damage. Each minelayer releases another asteroid every second turn."
msgstr ""

#. [message]: speaker=sw_hero_wedge
#: scenarios/the_last_command/01_the_siege_of_coruscant.cfg:168
msgid "We can't see the rocks, but we can see the ships dropping them. Two minelayers, east of the cordon."
msgstr ""

#. [message]: speaker=sw_hero_luke
#: scenarios/the_last_command/01_the_siege_of_coruscant.cfg:172
msgid "I can feel where some of the asteroids are, Wedge. Faintly. Fly where I fly."
msgstr ""

#. [message]: speaker=sw_hero_wedge
#: scenarios/the_last_command/01_the_siege_of_coruscant.cfg:217
msgid "Both minelayers down. The cordon stops growing. Now someone just has to sweep the rocks that are already up there."
msgstr ""

#. [scenario]: id=sw_tlc_02_the_smugglers_council
#: scenarios/the_last_command/02_the_smugglers_council.cfg:12
msgid "The Smugglers' Council"
msgstr ""

#. [part]
#: scenarios/the_last_command/02_the_smugglers_council.cfg:27
msgid "Talon Karrde had stayed neutral as long as neutrality paid. The Empire had stopped paying. He called the chiefs of the smuggling organizations to an old fortress on a dead world and asked them to choose a side."
msgstr ""

#. [part]
#: scenarios/the_last_command/02_the_smugglers_council.cfg:31
msgid "Someone among them had already chosen. The Imperial landing craft arrived before the first toast."
msgstr ""

#. [side]: id=sw_hero_karrde, type=sw_hero_karrde
#: scenarios/the_last_command/02_the_smugglers_council.cfg:42
msgid "Karrde's Organization"
msgstr ""

#. [side]: id=sw_tlc02_commander, type=sw_unit_im_officer
#: scenarios/the_last_command/02_the_smugglers_council.cfg:61
msgid "Imperial Raid"
msgstr ""

#. [side]: id=sw_tlc02_commander, type=sw_unit_im_officer
#: scenarios/the_last_command/02_the_smugglers_council.cfg:64
msgid "Colonel Mardek"
msgstr ""

#. [side]
#: scenarios/the_last_command/02_the_smugglers_council.cfg:89
msgid "Smuggler Chiefs"
msgstr ""

#. [side]
#: scenarios/the_last_command/02_the_smugglers_council.cfg:102
msgid "Mazzic"
msgstr ""

#. [side]
#: scenarios/the_last_command/02_the_smugglers_council.cfg:103
msgid "Ellor"
msgstr ""

#. [side]
#: scenarios/the_last_command/02_the_smugglers_council.cfg:104
msgid "Gillespee"
msgstr ""

#. [side]
#: scenarios/the_last_command/02_the_smugglers_council.cfg:105
msgid "Clyngunn"
msgstr ""

#. [side]
#: scenarios/the_last_command/02_the_smugglers_council.cfg:106
msgid "Par'tah"
msgstr ""

#. [objective]: condition=win
#: scenarios/the_last_command/02_the_smugglers_council.cfg:131
msgid "Hold the fortress until the last turn"
msgstr ""

#. [objective]: condition=win
#: scenarios/the_last_command/02_the_smugglers_council.cfg:135
msgid "Defeat Colonel Mardek"
msgstr ""

#. [objective]: condition=lose
#: scenarios/the_last_command/02_the_smugglers_council.cfg:139
msgid "Three smuggler chiefs killed"
msgstr ""

#. [objective]: condition=lose
#: scenarios/the_last_command/02_the_smugglers_council.cfg:143
msgid "Death of Karrde"
msgstr ""

#. [note]
#: scenarios/the_last_command/02_the_smugglers_council.cfg:147
#: scenarios/the_last_command/04_landfall_on_wayland.cfg:124
#: scenarios/the_last_command/05_the_natives_of_wayland.cfg:113
#: scenarios/the_last_command/08_the_throne_room.cfg:136
msgid "If Mara falls, she withdraws from the fight badly wounded and returns for the next mission."
msgstr ""

#. [message]: speaker=sw_tlc02_chief_1
#: scenarios/the_last_command/02_the_smugglers_council.cfg:158
msgid "Imperials! Karrde, you swore this place was clean!"
msgstr ""

#. [message]: speaker=sw_hero_karrde
#: scenarios/the_last_command/02_the_smugglers_council.cfg:162
msgid "It was, when I chose it. Someone at this table brought them. We'll find out who later. For now, the walls are thick and the doors are few."
msgstr ""

#. [message]: speaker=sw_hero_mara
#: scenarios/the_last_command/02_the_smugglers_council.cfg:166
msgid "I'll take the east gate. Try not to lose any chiefs while I'm busy."
msgstr ""

#. [message]: speaker=sw_hero_karrde
#: scenarios/the_last_command/02_the_smugglers_council.cfg:188
msgid "Too many of them are gone. There is no council left to save."
msgstr ""

#. [message]: speaker=sw_hero_karrde
#: scenarios/the_last_command/02_the_smugglers_council.cfg:218
msgid "The Empire tried to break us and failed. I think that settles the vote. Mara, send word to Coruscant: the smugglers are in."
msgstr ""

#. [message]: speaker=sw_hero_mara
#: scenarios/the_last_command/02_the_smugglers_council.cfg:222
msgid "And I'm going to Wayland. I know where the Emperor kept his storehouse. I was there once, a long time ago."
msgstr ""

#. [message]: speaker=$sw_tlc02_traitor
#: scenarios/the_last_command/02_the_smugglers_council.cfg:269
msgid "The Grand Admiral pays better than any of you ever did. Nothing personal, Karrde."
msgstr ""

#. [message]: speaker=sw_hero_karrde
#: scenarios/the_last_command/02_the_smugglers_council.cfg:293
msgid "So it was you, $sw_tlc02_traitor_name. Thirty credits to whoever brings him down."
msgstr ""

#. [message]: speaker=sw_hero_karrde
#: scenarios/the_last_command/02_the_smugglers_council.cfg:310
msgid "That settles $sw_tlc02_traitor_name|'s account. The bounty is paid."
msgstr ""

#. [part]
#: scenarios/the_last_command/03_the_palace_infiltrators.cfg:28
msgid "Leia's twins, Jacen and Jaina, were born in the Imperial Palace on Coruscant, behind more guards than any children in the galaxy."
msgstr ""

#. [part]
#: scenarios/the_last_command/03_the_palace_infiltrators.cfg:32
msgid "It was not enough. On a night when half the guard was at the orbital defenses, Imperial infiltrators came through the service corridors."
msgstr ""

#. [side]: id=sw_hero_leia, type=sw_hero_leia
#: scenarios/the_last_command/03_the_palace_infiltrators.cfg:43
msgid "Palace Guard"
msgstr ""

#. [side]
#: scenarios/the_last_command/03_the_palace_infiltrators.cfg:59
msgid "Imperial Infiltrators"
msgstr ""

#. [label]
#: scenarios/the_last_command/03_the_palace_infiltrators.cfg:103
msgid "Nursery"
msgstr ""

#. [objective]: condition=win
#: scenarios/the_last_command/03_the_palace_infiltrators.cfg:108
msgid "Defeat every infiltrator"
msgstr ""

#. [objective]: condition=lose
#: scenarios/the_last_command/03_the_palace_infiltrators.cfg:112
msgid "An infiltrator reaches the nursery"
msgstr ""

#. [note]
#: scenarios/the_last_command/03_the_palace_infiltrators.cfg:125
msgid "The Noghri now guard the Lady Vader: Noghri Commandos can be recruited."
msgstr ""

#. [message]: speaker=sw_hero_khabarakh
#: scenarios/the_last_command/03_the_palace_infiltrators.cfg:135
msgid "My lady. Movement in the service corridors. Not palace staff. They move the way we were trained to move."
msgstr ""

#. [message]: speaker=sw_hero_leia
#: scenarios/the_last_command/03_the_palace_infiltrators.cfg:139
msgid "They're after the twins. Chewie, the nursery door. Khabarakh, find them before they find us."
msgstr ""

#. [message]: speaker=sw_hero_leia
#: scenarios/the_last_command/03_the_palace_infiltrators.cfg:190
msgid "No!"
msgstr ""

#. [message]: speaker=sw_hero_leia
#: scenarios/the_last_command/03_the_palace_infiltrators.cfg:219
msgid "That's all of them. Han is going to hear about this the moment he lands, and then he'll want to go to Wayland too."
msgstr ""

#. [message]: speaker=sw_hero_khabarakh
#: scenarios/the_last_command/03_the_palace_infiltrators.cfg:223
msgid "Then we will all go, my lady. The Noghri have a debt to pay at Mount Tantiss."
msgstr ""

#. [part]
#: scenarios/the_last_command/04_landfall_on_wayland.cfg:29
msgid "Mara Jade remembered Wayland from the Emperor's service: a jungle world, a mountain, and inside the mountain a storehouse of everything the Emperor had wanted to keep."
msgstr ""

#. [part]
#: scenarios/the_last_command/04_landfall_on_wayland.cfg:33
msgid "She and Luke came in low and fast. Not low and fast enough. Their ship went down in the jungle a day's march from the mountain."
msgstr ""

#. [side]
#. [side]: id=sw_tlc06_commander, type=sw_unit_im_officer
#: scenarios/the_last_command/04_landfall_on_wayland.cfg:61
#: scenarios/the_last_command/06_the_gates_of_tantiss.cfg:56
msgid "Tantiss Garrison"
msgstr ""

#. [label]
#: scenarios/the_last_command/04_landfall_on_wayland.cfg:111
msgid "River Crossing"
msgstr ""

#. [objective]: condition=win
#: scenarios/the_last_command/04_landfall_on_wayland.cfg:116
msgid "Luke reaches the river crossing (with Mara, if she is still in the fight)"
msgstr ""

#. [note]
#: scenarios/the_last_command/04_landfall_on_wayland.cfg:127
msgid "Garrison patrols arrive from the north and south edges on turns 5 and 9."
msgstr ""

#. [message]: speaker=sw_hero_mara
#: scenarios/the_last_command/04_landfall_on_wayland.cfg:139
msgid "Well, we're on Wayland. The mountain's east, past the river. The garrison will have seen us come down."
msgstr ""

#. [message]: speaker=sw_hero_luke
#: scenarios/the_last_command/04_landfall_on_wayland.cfg:143
msgid "Then we don't wait for them. Mara, I can sense C'baoth from here. He knows we're coming."
msgstr ""

#. [message]: speaker=sw_hero_mara
#: scenarios/the_last_command/04_landfall_on_wayland.cfg:197
msgid "Across. There are natives in these hills, and they don't like the garrison any more than we do."
msgstr ""

#. [part]
#: scenarios/the_last_command/05_the_natives_of_wayland.cfg:24
msgid "Wayland's two native peoples, the four-armed Myneyrshi and the armored Psadans, had no love for each other and less for anyone from off-world. The Emperor's garrison had taught them that."
msgstr ""

#. [part]
#: scenarios/the_last_command/05_the_natives_of_wayland.cfg:28
msgid "Mara had an idea for earning their trust: break the outpost that taxed their villages."
msgstr ""

#. [side]: id=sw_tlc05_commander, type=sw_unit_im_officer
#: scenarios/the_last_command/05_the_natives_of_wayland.cfg:55
msgid "Garrison Outpost"
msgstr ""

#. [side]: id=sw_tlc05_commander, type=sw_unit_im_officer
#: scenarios/the_last_command/05_the_natives_of_wayland.cfg:58
msgid "Captain Brasck"
msgstr ""

#. [side]
#: scenarios/the_last_command/05_the_natives_of_wayland.cfg:83
msgid "Wayland Natives"
msgstr ""

#. [objective]: condition=win
#: scenarios/the_last_command/05_the_natives_of_wayland.cfg:105
msgid "Defeat Captain Brasck at the garrison outpost"
msgstr ""

#. [note]
#: scenarios/the_last_command/05_the_natives_of_wayland.cfg:116
msgid "On turn 4 Wayland's natives, the Myneyrshi and the Psadans, join the fight against the garrison."
msgstr ""

#. [message]: speaker=sw_hero_mara
#: scenarios/the_last_command/05_the_natives_of_wayland.cfg:128
msgid "The outpost is east. The villages around it pay the garrison in food and labor, or they burn."
msgstr ""

#. [message]: speaker=sw_hero_luke
#: scenarios/the_last_command/05_the_natives_of_wayland.cfg:132
msgid "Then we start there. The villagers are watching us. Let's give them something worth seeing."
msgstr ""

#. [message]: speaker=narrator
#: scenarios/the_last_command/05_the_natives_of_wayland.cfg:163
msgid "Myneyrshi War Leader"
msgstr ""

#. [message]: speaker=narrator
#: scenarios/the_last_command/05_the_natives_of_wayland.cfg:164
msgid "Outsiders who fight the mountain's soldiers. Strange. The Psadans have come too. Strange again. We will fight beside you, today."
msgstr ""

#. [message]: speaker=sw_hero_luke
#: scenarios/the_last_command/05_the_natives_of_wayland.cfg:175
msgid "The outpost is ours. Mara, I've reached Han. He's bringing Leia, Lando, Chewie, and a shipload of Noghri."
msgstr ""

#. [message]: speaker=sw_hero_mara
#: scenarios/the_last_command/05_the_natives_of_wayland.cfg:179
msgid "Good. The natives know a way to the mountain's main gate. We'll need every one of them."
msgstr ""

#. [part]
#: scenarios/the_last_command/06_the_gates_of_tantiss.cfg:26
msgid "Han brought the Falcon in under the mountain's sensors with Leia, Lando, Chewbacca, and a team of Noghri commandos. The natives had shown them the road to the gate."
msgstr ""

#. [part]
#: scenarios/the_last_command/06_the_gates_of_tantiss.cfg:30
msgid "Inside, Luke and Mara were already climbing toward the throne room. Outside, someone had to bring down the shield."
msgstr ""

#. [side]: id=sw_hero_han, type=sw_hero_han
#: scenarios/the_last_command/06_the_gates_of_tantiss.cfg:41
#: scenarios/the_last_command/07_the_cloning_vats.cfg:36
msgid "Assault Team"
msgstr ""

#. [side]: id=sw_tlc06_commander, type=sw_unit_im_officer
#: scenarios/the_last_command/06_the_gates_of_tantiss.cfg:59
msgid "General Covell"
msgstr ""

#. [objective]: condition=win
#: scenarios/the_last_command/06_the_gates_of_tantiss.cfg:111
msgid "Destroy the shield generator at the mountain gate"
msgstr ""

#. [note]
#: scenarios/the_last_command/06_the_gates_of_tantiss.cfg:119
msgid "If Leia, Lando, Chewbacca or Khabarakh falls, that hero withdraws from the fight badly wounded and returns for the next mission."
msgstr ""

#. [objectives]
#: scenarios/the_last_command/06_the_gates_of_tantiss.cfg:124
msgid "Keep Leia Organa Solo and Chewbacca in the fight to the end"
msgstr ""

#. [message]: speaker=sw_hero_han
#: scenarios/the_last_command/06_the_gates_of_tantiss.cfg:135
msgid "That's the gate, and that's the shield generator beside it. Take it down and we can walk in."
msgstr ""

#. [message]: speaker=sw_hero_leia
#: scenarios/the_last_command/06_the_gates_of_tantiss.cfg:139
msgid "Luke's inside already. I can feel him, and something else. Something that feels like him and isn't."
msgstr ""

#. [message]: speaker=sw_hero_lando
#: scenarios/the_last_command/06_the_gates_of_tantiss.cfg:150
msgid "Shield's down! Gate's open!"
msgstr ""

#. [message]: speaker=sw_hero_han
#: scenarios/the_last_command/06_the_gates_of_tantiss.cfg:154
msgid "Chewie, Lando, with me. We're going for the cloning vats. Leia, keep the gate."
msgstr ""

#. [message]: speaker=sw_hero_lando
#: scenarios/the_last_command/06_the_gates_of_tantiss.cfg:197
msgid "The gate's opening! They're coming out to meet us."
msgstr ""

#. [message]: speaker=sw_hero_han
#: scenarios/the_last_command/06_the_gates_of_tantiss.cfg:220
msgid "Company on the ridge. The locals. Looks like they've decided whose side they're on, and it isn't the mountain's."
msgstr ""

#. [part]
#: scenarios/the_last_command/07_the_cloning_vats.cfg:25
msgid "Deep in the mountain stood rows of tall glass cylinders, each one growing a soldier for the Grand Admiral's fleet."
msgstr ""

#. [side]
#: scenarios/the_last_command/07_the_cloning_vats.cfg:52
msgid "Vat Guards"
msgstr ""

#. [objective]: condition=win
#: scenarios/the_last_command/07_the_cloning_vats.cfg:111
msgid "Destroy all eight cloning cylinders"
msgstr ""

#. [note]
#: scenarios/the_last_command/07_the_cloning_vats.cfg:119
msgid "If Lando or Chewbacca falls, that hero withdraws from the fight badly wounded and returns for the next mission."
msgstr ""

#. [note]
#: scenarios/the_last_command/07_the_cloning_vats.cfg:122
msgid "Imperial Remnant clone reinforcements arrive on turns 5 and 9."
msgstr ""

#. [objectives]
#: scenarios/the_last_command/07_the_cloning_vats.cfg:126
msgid "Keep Lando Calrissian and Chewbacca in the fight to the end"
msgstr ""

#. [message]: speaker=sw_hero_lando
#: scenarios/the_last_command/07_the_cloning_vats.cfg:134
msgid "Han. Look at them. Rows of them. That's where the clones are coming from."
msgstr ""

#. [message]: speaker=sw_hero_han
#: scenarios/the_last_command/07_the_cloning_vats.cfg:138
msgid "Not after today. Wreck every one of those tanks."
msgstr ""

#. [message]: speaker=sw_hero_han
#: scenarios/the_last_command/07_the_cloning_vats.cfg:178
msgid "That's the last of them. Now let's find Luke before this mountain comes down on all of us."
msgstr ""

#. [part]
#: scenarios/the_last_command/08_the_throne_room.cfg:26
msgid "At the heart of the mountain was the Emperor's throne room, and on the throne sat Joruus C'baoth."
msgstr ""

#. [part]
#: scenarios/the_last_command/08_the_throne_room.cfg:30
msgid "Beside him stood a young man with Luke Skywalker's face, holding a lightsaber that burned like Luke's. C'baoth had grown him from the hand Luke lost at Bespin."
msgstr ""

#. [unit]: id=sw_hero_luuke, type=sw_hero_luuke
#: scenarios/the_last_command/08_the_throne_room.cfg:86
msgid "Luuke"
msgstr ""

#. [objective]: condition=win
#: scenarios/the_last_command/08_the_throne_room.cfg:128
msgid "Defeat Joruus C'baoth and his clone Luuke"
msgstr ""

#. [note]
#: scenarios/the_last_command/08_the_throne_room.cfg:140
msgid "Mara brought a ysalamiri. Inside the violet hexes no one can use the Force: not Luke, not the clone, not C'baoth."
msgstr ""

#. [message]: speaker=sw_hero_cbaoth
#: scenarios/the_last_command/08_the_throne_room.cfg:150
msgid "Skywalker. You came back to me, as I said you would. Meet the apprentice you refused to be."
msgstr ""

#. [message]: speaker=sw_hero_luuke
#: scenarios/the_last_command/08_the_throne_room.cfg:154
msgid "..."
msgstr ""

#. [message]: speaker=sw_hero_mara
#: scenarios/the_last_command/08_the_throne_room.cfg:158
msgid "I know why I've wanted to kill you, Skywalker. It was never you. It was always him."
msgstr ""

#. [message]: speaker=sw_hero_luke
#: scenarios/the_last_command/08_the_throne_room.cfg:162
msgid "Then let's finish it. Together."
msgstr ""

#. [message]: speaker=sw_hero_cbaoth
#: scenarios/the_last_command/08_the_throne_room.cfg:209
msgid "You destroy what I made for you? Then I will unmake you myself!"
msgstr ""

#. [message]: speaker=sw_hero_mara
#: scenarios/the_last_command/08_the_throne_room.cfg:229
msgid "It's done. The voice that kept telling me to kill you is gone."
msgstr ""

#. [message]: speaker=sw_hero_luke
#: scenarios/the_last_command/08_the_throne_room.cfg:233
msgid "And the mountain is coming down. Let's go."
msgstr ""

#. [part]
#: scenarios/the_last_command/09_bilbringi.cfg:30
msgid "With the cloning vats gone, the Grand Admiral could no longer grow new crews. The New Republic struck at the shipyards that built his ships."
msgstr ""

#. [side]: id=sw_hero_wedge, type=sw_hero_wedge
#: scenarios/the_last_command/09_bilbringi.cfg:41
#: scenarios/the_last_command/10_the_last_command.cfg:43
msgid "New Republic Strike Force"
msgstr ""

#. [side]: id=sw_tlc09_command, type=sw_unit_im_star_destroyer
#: scenarios/the_last_command/09_bilbringi.cfg:56
msgid "Bilbringi Command"
msgstr ""

#. [side]: id=sw_tlc09_command, type=sw_unit_im_star_destroyer
#: scenarios/the_last_command/09_bilbringi.cfg:59
msgid "Death's Head"
msgstr ""

#. [objective]: condition=win
#: scenarios/the_last_command/09_bilbringi.cfg:123
msgid "Destroy three shipyard platforms"
msgstr ""

#. [note]
#: scenarios/the_last_command/09_bilbringi.cfg:136
msgid "A screen of cloaked asteroids guards the yards. Ships that end their turn next to one take 8 damage."
msgstr ""

#. [message]: speaker=sw_hero_wedge
#: scenarios/the_last_command/09_bilbringi.cfg:148
msgid "He's using his own trick against us: an asteroid screen in front of the yards. Luke?"
msgstr ""

#. [message]: speaker=sw_hero_luke
#: scenarios/the_last_command/09_bilbringi.cfg:152
msgid "I can sense some of them. Follow my lead through the gaps."
msgstr ""

#. [message]: speaker=sw_hero_wedge
#: scenarios/the_last_command/09_bilbringi.cfg:174
msgid "Three platforms gone. The yards won't be building anything for a long time."
msgstr ""

#. [message]: speaker=sw_hero_luke
#: scenarios/the_last_command/09_bilbringi.cfg:178
msgid "Wedge, new contacts on the long-range scopes. The Chimaera. Thrawn is coming himself."
msgstr ""

#. [message]: speaker=sw_hero_wedge
#: scenarios/the_last_command/09_bilbringi.cfg:230
msgid "Whoa! The reactor went up with it. Everybody keep a hex clear of those platforms when they blow."
msgstr ""

#. [message]: speaker=sw_hero_luke
#: scenarios/the_last_command/09_bilbringi.cfg:257
msgid "Wedge, they've released more of them. Closer this time, behind us. I can't tell exactly where."
msgstr ""

#. [part]
#: scenarios/the_last_command/10_the_last_command.cfg:28
msgid "The Grand Admiral brought his fleet to Bilbringi to destroy the New Republic's strike force. It was a good plan. His plans were always good."
msgstr ""

#. [part]
#: scenarios/the_last_command/10_the_last_command.cfg:32
msgid "On the bridge of the Chimaera, his Noghri bodyguard Rukh stood behind him, as he always did. Rukh had heard from his own people what the Empire had done to Honoghr."
msgstr ""

#. [side]: id=sw_tlc10_escort_n, type=sw_unit_im_star_destroyer
#: scenarios/the_last_command/10_the_last_command.cfg:83
#: scenarios/the_last_command/10_the_last_command.cfg:86
msgid "Stormhawk"
msgstr ""

#. [side]: id=sw_tlc10_escort_s, type=sw_unit_im_star_destroyer
#: scenarios/the_last_command/10_the_last_command.cfg:100
#: scenarios/the_last_command/10_the_last_command.cfg:103
msgid "Nemesis"
msgstr ""

#. [objective]: condition=win
#: scenarios/the_last_command/10_the_last_command.cfg:134
msgid "Hold the line until the Imperial fleet breaks (turn 10)"
msgstr ""

#. [objective]: condition=win
#: scenarios/the_last_command/10_the_last_command.cfg:138
msgid "Destroy both escort Star Destroyers, Stormhawk and Nemesis"
msgstr ""

#. [event]
#: scenarios/the_last_command/10_the_last_command.cfg:154
msgid "Their formation favors the left. A habit from their pilots' training on Corellia. Captain, shift the screen."
msgstr ""

#. [message]: speaker=sw_hero_wedge
#: scenarios/the_last_command/10_the_last_command.cfg:157
msgid "He's reading us again. All right, Rogues: no habits today. Break and attack."
msgstr ""

#. [message]: speaker=narrator
#: scenarios/the_last_command/10_the_last_command.cfg:194
msgid "Bridge of the Chimaera"
msgstr ""

#. [message]: speaker=narrator
#: scenarios/the_last_command/10_the_last_command.cfg:195
msgid "Rukh stepped forward in silence. When it was over, the Grand Admiral sat back in his command chair and looked at the tactical display one last time."
msgstr ""

#. [event]
#: scenarios/the_last_command/10_the_last_command.cfg:197
msgid "The Noghri. Of course. Every culture shows itself in time... and I never studied my own guard."
msgstr ""

#. [message]: speaker=narrator
#: scenarios/the_last_command/10_the_last_command.cfg:202
msgid "Signal the fleet. All ships, disengage and withdraw to the rendezvous. ... That is an order."
msgstr ""

#. [message]: speaker=sw_hero_wedge
#: scenarios/the_last_command/10_the_last_command.cfg:206
msgid "They're breaking off. All of them. Luke, what just happened over there?"
msgstr ""

#. [message]: speaker=sw_hero_luke
#: scenarios/the_last_command/10_the_last_command.cfg:210
msgid "I don't know. But I felt it end. Whatever he was planning, it's over."
msgstr ""

#. [endlevel]
#: scenarios/the_last_command/10_the_last_command.cfg:214
msgid ""
"The Grand Admiral is dead, and the Imperial Remnant falls back into the dark. For now, the New Republic endures.\n"
"\n"
"Thank you for playing the Thrawn Trilogy."
msgstr ""

#. [event]
#: scenarios/the_last_command/10_the_last_command.cfg:244
msgid "Their training tells them the space behind them is safe. Captain, release the reserve."
msgstr ""

#. [message]: speaker=sw_hero_wedge
#: scenarios/the_last_command/10_the_last_command.cfg:254
msgid "Interceptors on our six! They were sitting dark behind us the whole time. Rogues, watch your backs!"
msgstr ""

#. [event]
#: scenarios/the_last_command/10_the_last_command.cfg:275
msgid "Commander Antilles, this is Karrde. The smugglers you once chased across half the galaxy would like a word with the Grand Admiral. Where do you want us?"
msgstr ""

#. [message]: speaker=sw_hero_wedge
#: scenarios/the_last_command/10_the_last_command.cfg:278
msgid "Karrde! Ion cannons on those escorts. Never thought I'd be glad to see a smuggler run."
msgstr ""

#. [chance_to_hit]: id=sw_special_flanking
#: units/00_sw_specials.cfg:16
