#: units/infantry.cfg:499
msgid "New Republic Combat Engineer Squad"
msgstr ""

#. [unit_type]: id=sw_unit_nr_engineer_squad, race=human
#: units/infantry.cfg:500
msgid "A hardened support squad trained in field engineering and close-quarters defense. Equipped with a compact blaster and portable engineering tools, the Combat Engineer Squad reinforces defensive positions, prepares field fortifications, and holds the line at short range. Their moderate armor and steady close-range fire make them reliable defenders rather than fast strikers or distant snipers."
msgstr ""

#. [attack]: type=impact
#: units/infantry.cfg:595
